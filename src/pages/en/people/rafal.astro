---
// Founder's business card (English twin of /people/rafal/). Same sections:
// hero → booking → socials stage → career axis → homepage CTA → the shared contact form.
import Contact from "@/components/contact.astro";
import Footer from "@/components/footer.astro";
import Nav from "@/components/nav.astro";
import PeopleBooking from "@/components/people/booking.astro";
import PeopleHero from "@/components/people/hero.astro";
import PeopleSocials from "@/components/people/socials.astro";
import PeopleTimeline from "@/components/people/timeline.astro";
import { getPeopleRafal, peopleRafalPath } from "@/data/people-rafal";
import Base from "@/layouts/base.astro";

const locale = "en";
const p = getPeopleRafal(locale);
const altPath = peopleRafalPath("pl");
---

<Base title={p.meta.title} description={p.meta.description} locale={locale} altPath={altPath}>
  <Nav locale={locale} altPath={altPath} links={p.nav.links} cta={{ label: p.nav.cta, href: "#umow" }} />
  <main>
    <PeopleHero locale={locale} />
    <PeopleBooking locale={locale} />
    <PeopleSocials locale={locale} />
    <PeopleTimeline locale={locale} />
    <PeopleBooking locale={locale} variant="showcase" />
    <Contact
      locale={locale}
      copy={p.contact}
      channels={{ title: p.contact.channelsTitle, items: p.contact.channels }}
    />
  </main>
  <Footer locale={locale} />
</Base>
