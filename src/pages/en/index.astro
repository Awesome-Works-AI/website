---
import ChatWidget from "@/components/chat-widget.astro";
import Contact from "@/components/contact.astro";
import Faq from "@/components/faq.astro";
import Footer from "@/components/footer.astro";
import Hero from "@/components/hero.astro";
import Nav from "@/components/nav.astro";
import Process from "@/components/process.astro";
import Products from "@/components/products.astro";
import Reviews from "@/components/reviews.astro";
import ServicesSticky from "@/components/services-sticky.astro";
import ServicesCascade from "@/components/services-cascade.astro";
import ServicesScene from "@/components/services-scene.astro";
import { getCompanyHome } from "@/data/company-home";
import { fetchGoogleReviews } from "@/data/google-reviews";
import Base from "@/layouts/base.astro";

const locale = "en";
const home = getCompanyHome(locale);

// Reviews render only with live Google data (no placeholders by design);
// the #opinie nav anchor appears together with the section.
const placeInfo = await fetchGoogleReviews();
const hasReviews = (placeInfo?.reviews.length ?? 0) > 0;
---

<Base
  title={home.meta.title}
  description={home.meta.description}
  socialDescription={home.meta.socialDescription}
  locale={locale}
  includeFaqSchema={true}
  preloadImages={[`/projects/callwise-${locale}.webp`]}
>
  <Nav locale={locale} showReviews={hasReviews} />
  <main>
    <Hero locale={locale} />
    <ServicesSticky locale={locale} />
    <ServicesCascade locale={locale} />
    <ServicesScene locale={locale} />
    <Products locale={locale} />
    <Process locale={locale} />
    {hasReviews && placeInfo && <Reviews locale={locale} placeInfo={placeInfo} />}
    <Faq locale={locale} />
    <Contact locale={locale} />
  </main>
  <Footer locale={locale} />
  <ChatWidget locale={locale} />
</Base>
