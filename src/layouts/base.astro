---
import "@fontsource/archivo/400.css";
import "@fontsource/archivo/500.css";
import "@fontsource/archivo/700.css";
import "@fontsource/archivo-black/400.css";
import "@/styles/globals.css";
import { getCompanyHome, organizationSameAs, personSameAs } from "@/data/company-home";
import type { Locale } from "@/i18n/utils";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  ogImage?: string;
  socialDescription?: string;
  includeFaqSchema?: boolean;
}

const {
  title,
  description,
  locale,
  ogImage,
  socialDescription,
  includeFaqSchema = false,
} = Astro.props;
const altLocale = locale === "en" ? "pl" : "en";
const siteBase = Astro.site?.href ?? "https://awesomeworks.ai";
const canonicalUrl = new URL(Astro.url.pathname, siteBase);
const localizedPath = /^\/(pl|en)(?=\/|$)/.test(Astro.url.pathname) ? Astro.url.pathname : `/${locale}/`;
const altPath = localizedPath.replace(/^\/(pl|en)(?=\/|$)/, `/${altLocale}`);
const defaultPath = localizedPath.replace(/^\/(pl|en)(?=\/|$)/, "/en");
const altUrl = new URL(altPath, siteBase);
const defaultUrl = new URL(defaultPath, siteBase);
const ogImageAbsolute = new URL(ogImage ?? "/og-image.png", siteBase).href;
const organizationId = new URL("#organization", siteBase).href;
const personId = new URL("#rafal-lazicki", siteBase).href;
const resolvedSocialDescription = socialDescription ?? description;

const i = getCompanyHome(locale);
const ogImageAlt = i.meta.ogImageAlt;

// Organization is the primary subject; the founder Person stays for SEO
// continuity (no UI exposure).
const services =
  locale === "pl"
    ? ["Agenci głosowi AI", "Agenci konwersacyjni AI", "Oprogramowanie na zamówienie", "Szkolenia AI"]
    : ["AI voice agents", "AI chat agents", "Custom software development", "AI training"];

const knowsAbout =
  locale === "pl"
    ? [
        "Agenci AI",
        "Agenci głosowi",
        "Agenci konwersacyjni",
        "Oprogramowanie na zamówienie",
        "LLM",
        "Automatyzacja procesów biznesowych",
        "Szkolenia AI",
      ]
    : [
        "AI agents",
        "Voice agents",
        "Conversational agents",
        "Custom software",
        "LLM applications",
        "Business process automation",
        "AI training",
      ];

const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": organizationId,
  name: "AwesomeWorks",
  legalName: "Awesome Works AI Rafał Łazicki",
  url: siteBase,
  logo: new URL("/brand/monogram.png", siteBase).href,
  image: ogImageAbsolute,
  description: description,
  foundingDate: "2021",
  sameAs: organizationSameAs,
  founder: {
    "@id": personId,
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Warsaw",
    addressCountry: "PL",
  },
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "sales",
    email: "hello@awesomeworks.ai",
    availableLanguage: ["English", "Polish"],
  },
  knowsAbout,
  makesOffer: services.map((name) => ({
    "@type": "Offer",
    itemOffered: {
      "@type": "Service",
      name,
    },
  })),
  owns: [
    {
      "@type": "Product",
      name: "odbiera.ai",
      url: "https://odbiera.ai/",
    },
    {
      "@type": "Product",
      name: "CallWise",
      url: "https://callwise.awesomeworks.ai/",
    },
    {
      "@type": "Product",
      name: "CourseAI",
      url: "https://course.awesomeworks.ai/",
    },
  ],
};

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": personId,
  name: "Rafał Łazicki",
  url: siteBase,
  image: new URL("/rafal.jpeg", siteBase).href,
  jobTitle: "Founder",
  sameAs: personSameAs,
  worksFor: {
    "@id": organizationId,
  },
};

const faqJsonLd = includeFaqSchema
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: i.faq.items.map((item) => ({
        "@type": "Question",
        name: item.q,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.a,
        },
      })),
    }
  : null;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#F2F2EE" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="alternate" hreflang={locale} href={canonicalUrl.href} />
    <link rel="alternate" hreflang={altLocale} href={altUrl.href} />
    <link rel="alternate" hreflang="x-default" href={defaultUrl.href} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AwesomeWorks" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={resolvedSocialDescription} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:image:url" content={ogImageAbsolute} />
    <meta property="og:image:secure_url" content={ogImageAbsolute} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:locale" content={locale === "en" ? "en_US" : "pl_PL"} />
    <meta
      property="og:locale:alternate"
      content={locale === "en" ? "pl_PL" : "en_US"}
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@awesomeworksai" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={resolvedSocialDescription} />
    <meta name="twitter:image" content={ogImageAbsolute} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="image_src" href={ogImageAbsolute} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
    {
      faqJsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    }
  </head>
  <body class="min-h-[100dvh] overflow-x-hidden bg-offwhite font-sans text-ink">
    <slot />
  </body>
</html>
