---
// Faithful vector trace of the waving brand mascot (hello.webp), cut into
// animatable layers: rm-antenna (sway), rm-eye per eye (blink), and the
// glove as the waving hand. The glove is drawn raised, so a +44deg wrapper
// and a scoped -44deg base recentre the rm-wave keyframes (-32..-56deg)
// to a +/-12deg swing around the drawn pose, pivoting at the wrist.
interface Props {
  /** false renders the glove static in the drawn pose (no wave loop). */
  wave?: boolean;
  class?: string;
}

const { wave = true, class: className = "" } = Astro.props;
const armClass = wave ? "rm-arm-wave rm-t" : "rm-arm-rest";
