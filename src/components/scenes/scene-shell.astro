---
// One full-viewport service scene (Apple-style). Desktop: the outer wrapper
// is taller than the viewport and the inner view pins (CSS sticky); a GSAP
// scrub timeline in hero-scenes.astro walks the scene's [data-fx] elements.
// Mobile: no pinning — the scene is a normal section, animations play once.
// No element is hidden by CSS: with JS off (or reduced motion) every scene
// renders complete and static.
import Icon from "@/components/icon.astro";
import type { CompanyHomeContent } from "@/data/company-home";

interface Props {
  scene: string;
  index: number;
  item: CompanyHomeContent["services"]["items"][number];
  ofLabel: string;
  /** Which side the visual takes on desktop. */
  visual: "left" | "right";
  /** Scene ground: paper, raised white, or full-dark ink. */
  ground?: "paper" | "white" | "ink";
}

const { scene, index, item, ofLabel, visual, ground = "paper" } = Astro.props;
const num = String(index).padStart(2, "0");
const dark = ground === "ink";
const bg = ground === "ink" ? "bg-ink" : ground === "white" ? "bg-white" : "bg-offwhite";
---

<section data-scene={scene} class:list={["relative border-t-[3px] border-ink lg:h-[240svh]", bg]}>
  <div class="flex flex-col overflow-hidden pt-[51px] lg:sticky lg:top-0 lg:h-[100svh]">
    <div
      class="mx-auto grid w-full max-w-[88rem] flex-1 content-center items-center gap-10 px-6 py-16 md:py-20 lg:grid-cols-12 lg:gap-10 lg:px-10 lg:py-0"
    >
      {/* Text block */}
      <div
        class:list={[
          "flex flex-col items-start gap-5 lg:col-span-5 lg:gap-6",
          visual === "left" && "lg:order-last",
        ]}
        data-fx="head"
      >
        <p class="font-display text-lg text-cobalt" aria-hidden="true" data-fx="num">
          {num} <span class:list={["ml-1", dark ? "text-offwhite/40" : "text-ink/30"]}>{ofLabel}</span>
        </p>
        <h2
          class:list={[
            "font-display text-4xl uppercase leading-[1.02] tracking-tight [text-wrap:balance] md:text-5xl lg:text-[clamp(3.2rem,4.6vw,4.4rem)]",
            dark ? "text-offwhite" : "text-ink",
          ]}
          data-fx="title"
        >
          {item.name}
        </h2>
        <p
          class:list={["max-w-[46ch] text-lg font-medium leading-normal", dark ? "text-offwhite/90" : "text-ink"]}
          data-fx="text"
        >
          {item.text}
        </p>
        {
          item.proofHref ? (
            <a
              href={item.proofHref}
              target="_blank"
              rel="noopener"
              data-fx="proof"
              class:list={[
                "inline-flex items-center gap-1.5 text-base font-bold underline decoration-cobalt decoration-[3px] underline-offset-4 hover:text-cobalt",
                dark ? "text-offwhite" : "text-ink",
              ]}
            >
              {item.proofLabel}
              <Icon name="external-link" class="h-3.5 w-3.5 flex-none" />
            </a>
          ) : (
            <p class:list={["text-base font-bold", dark ? "text-offwhite" : "text-ink"]} data-fx="proof">
              {item.proofLabel}
            </p>
          )
        }
      </div>

      {/* Visual block */}
      <div class="relative min-w-0 lg:col-span-7">
        <slot />
      </div>
    </div>
  </div>
</section>
