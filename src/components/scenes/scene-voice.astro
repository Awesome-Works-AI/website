---
// Voice agents scene: the headset mascot in full contrast next to a call
// card. The conversation is pure VOICE — each turn is a waveform capsule
// (no text bubbles, this must not read as chat): caller turns on paper,
// agent turns on cobalt. Turns land one by one on scrub; the last agent
// turn pulses live. Header carries the call status and a mini equalizer.
import Icon from "@/components/icon.astro";
import RobotMascot from "@/components/scenes/robot-mascot.astro";
import SceneShell from "@/components/scenes/scene-shell.astro";
import type { CompanyHomeContent } from "@/data/company-home";

interface Props {
  item: CompanyHomeContent["services"]["items"][number];
  copy: CompanyHomeContent["scenes"]["voice"];
  ofLabel: string;
}

const { item, copy, ofLabel } = Astro.props;
const headerBars = [14, 22, 10, 24, 16, 26, 12, 20, 9];

// Purely decorative "speech" patterns (bar heights in px) — lengths differ
// so the exchange reads naturally: question, longer answer, short reply,
// closing confirmation. The last agent turn animates as currently speaking.
const wave = (seed: number, n: number) =>
  Array.from({ length: n }, (_, k) => 6 + Math.round(8.5 * (1 + Math.sin(seed + k * 1.7)) * 0.9));

const turns = [
  { who: "caller" as const, bars: wave(1, 20) },
  { who: "bot" as const, bars: wave(4, 30) },
  { who: "caller" as const, bars: wave(8, 9) },
  { who: "bot" as const, bars: wave(12, 24), live: true },
];
---

<SceneShell scene="voice" index={2} item={item} ofLabel={ofLabel} visual="left" ground="white">
  <div class="flex flex-col items-center gap-6 lg:flex-row lg:items-center lg:gap-0">
    <div data-fx="robot" class="flex-none">
      <RobotMascot headset class="h-64 w-auto md:h-80 lg:h-[26rem]" />
    </div>

    {/* Call card */}
    <div
      data-fx="card"
      class="w-full max-w-[24rem] border-[3px] border-ink bg-white shadow-[8px_8px_0_var(--color-ink)] lg:-ml-8"
    >
      <div class="flex items-center gap-3 border-b-[3px] border-ink px-4 py-3">
        <span class="grid h-10 w-10 flex-none place-items-center bg-cobalt text-white">
          <Icon name="phone" class="h-5 w-5" />
        </span>
        <div class="grid min-w-0 flex-1">
          <p data-fx="status-in" class="col-start-1 row-start-1 truncate text-sm font-bold text-ink opacity-0">
            {copy.incoming}
          </p>
          <p data-fx="status-on" class="col-start-1 row-start-1 truncate text-sm font-bold text-cobalt">
            {copy.answered}
          </p>
        </div>
        <div class="flex h-7 flex-none items-center gap-[3px]" aria-hidden="true">
          {headerBars.map((h, k) => <span class="wf-bar" style={`height:${h}px; --i:${k};`} />)}
        </div>
      </div>

      {/* Voice turns — waveform capsules, no text */}
      <ul class="flex flex-col gap-3.5 p-4" role="img" aria-label={item.imageAlt}>
        {
          turns.map((turn) => (
            <li
              data-fx="line"
              class:list={[
                "flex max-w-[88%] flex-col gap-1",
                turn.who === "bot" ? "items-end self-end" : "items-start self-start",
              ]}
            >
              <span class="text-[10px] font-bold uppercase tracking-[0.14em] text-ink/45">
                {turn.who === "bot" ? copy.botLabel : copy.callerLabel}
              </span>
              <span
                class:list={[
                  "flex h-10 items-center gap-[3px] px-3.5",
                  turn.who === "bot" ? "bg-cobalt text-white" : "bg-offwhite text-ink/80",
                  turn.live && "vn-live",
                ]}
              >
                {turn.bars.map((h, k) => (
                  <span class="vn-bar" style={`height:${h}px; --i:${k};`} />
                ))}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</SceneShell>
