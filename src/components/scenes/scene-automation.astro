---
// AI automations scene: the headset agent oversees an SVG pipeline — mail/
// CRM/documents cards feed the AI hub (mascot face, cobalt pulse) which
// produces the report card. Cards carry the brutal offset shadow; source
// icons are the Phosphor-thin set from the business card. The scrub
// timeline pops the cards and draws the connectors; cobalt data dots flow
// along the paths as a CSS loop (offset-path, gated by .scene-live).
import RobotMascot from "@/components/scenes/robot-mascot.astro";
import SceneShell from "@/components/scenes/scene-shell.astro";
import type { CompanyHomeContent } from "@/data/company-home";

interface Props {
  item: CompanyHomeContent["services"]["items"][number];
  labels: CompanyHomeContent["scenes"]["automation"]["nodes"];
  ofLabel: string;
}

const { item, labels, ofLabel } = Astro.props;

// Connector paths shared by the drawn lines and the flowing dots.
const paths = {
  mail: "M190 72 H250 Q266 72 266 88 V164 Q266 180 282 180 H300",
  crm: "M190 204 H252 Q268 204 268 212 Q268 220 284 220 H300",
  docs: "M190 336 H250 Q266 336 266 320 V276 Q266 260 282 260 H300",
  report: "M437 220 H533",
};

// Phosphor-thin icon paths (256 grid, fill) — the business-card set.
const ph = {
  mail: "M224,52H32a4,4,0,0,0-4,4V192a12,12,0,0,0,12,12H216a12,12,0,0,0,12-12V56A4,4,0,0,0,224,52Zm-10.28,8L128,138.57,42.28,60ZM216,196H40a4,4,0,0,1-4-4V65.09L125.3,147a4,4,0,0,0,5.4,0L220,65.09V192A4,4,0,0,1,216,196Z",
  crm: "M162.84,93.16a4,4,0,0,1,0,5.66l-64,64a4,4,0,0,1-5.66-5.66l64-64A4,4,0,0,1,162.84,93.16Zm49.95-49.95a52.07,52.07,0,0,0-73.56,0L109.17,73.27a4,4,0,0,0,5.65,5.66l30.07-30.06a44,44,0,0,1,62.24,62.24l-30.07,30.06a4,4,0,0,0,5.66,5.66l30.07-30.06A52.07,52.07,0,0,0,212.79,43.21ZM141.17,177.06l-30.06,30.07a44,44,0,0,1-62.24-62.24l30.06-30.06a4,4,0,0,0-5.66-5.66L43.21,139.23a52,52,0,0,0,73.56,73.56l30.06-30.07a4,4,0,1,0-5.66-5.66Z",
  docs: "M200,224H56a4,4,0,0,1-4-4V36a4,4,0,0,1,4-4h96l52,52V220A4,4,0,0,1,200,224ZM60,216H196V87.31L148.69,40H60ZM152,88h44l-48-48V84A4,4,0,0,0,152,88ZM88,128h80a4,4,0,0,0,0-8H88a4,4,0,0,0,0,8Zm0,32h80a4,4,0,0,0,0-8H88a4,4,0,0,0,0,8Zm0,32h48a4,4,0,0,0,0-8H88a4,4,0,0,0,0,8Z",
};

const sources = [
  { key: "mail", y: 36, label: labels.mail },
  { key: "crm", y: 168, label: labels.crm },
  { key: "docs", y: 300, label: labels.docs },
] as const;
---

<SceneShell scene="automation" index={1} item={item} ofLabel={ofLabel} visual="right">
  <div class="flex items-end justify-center gap-1">
    {/* The agent overseeing the pipeline */}
    <div data-fx="robot" class="-mr-3 mb-1 hidden flex-none lg:block">
      <RobotMascot headset class="h-44 w-auto xl:h-52" />
    </div>

    <svg viewBox="0 0 680 460" class="w-full max-w-[38rem] min-w-0" role="img" aria-label={item.imageAlt}>
      {/* Connectors (drawn on scrub) */}
      {
        Object.values(paths).map((d) => (
          <path d={d} class="stroke-ink" stroke-width="4" fill="none" data-draw />
        ))
      }

      {/* Source cards: brutal offset shadow, phosphor icon on cobalt, label */}
      {
        sources.map((s) => (
          <g data-fx="node">
            <rect x="23" y={s.y + 7} width="170" height="72" class="fill-ink" />
            <rect x="16" y={s.y} width="170" height="72" class="fill-white stroke-ink" stroke-width="4" />
            <rect x="32" y={s.y + 16} width="40" height="40" class="fill-cobalt" />
            <g transform={`translate(36 ${s.y + 20}) scale(0.125)`}>
              <path d={ph[s.key]} class="fill-white" />
            </g>
            <text x="84" y={s.y + 42} class="fill-ink text-[13.5px] font-bold uppercase tracking-wide">
              {s.label}
            </text>
          </g>
        ))
      }

      {/* AI hub: cobalt block with the mascot's face + idle pulse ring */}
      <g data-fx="node">
        <circle class="ai-pulse stroke-cobalt" cx="365" cy="220" r="78" fill="none" stroke-width="3" />
        <rect x="307" y="162" width="130" height="130" class="fill-ink" />
        <rect x="300" y="155" width="130" height="130" class="fill-cobalt" />
        <rect x="326" y="181" width="78" height="56" rx="25" class="fill-white" />
        <rect x="337" y="192" width="56" height="34" rx="17" class="fill-ink" />
        <path d="M347 213 Q352 206 357 213" class="stroke-white" stroke-width="4" stroke-linecap="round" fill="none" />
        <path d="M372 213 Q377 206 382 213" class="stroke-white" stroke-width="4" stroke-linecap="round" fill="none" />
        <line x1="365" y1="181" x2="365" y2="170" class="stroke-white" stroke-width="4" stroke-linecap="round" />
        <circle cx="365" cy="166" r="5" class="fill-white" />
        <text x="365" y="268" text-anchor="middle" class="fill-white text-[18px] font-bold uppercase tracking-wide">
          {labels.ai}
        </text>
      </g>

      {/* Report card: cobalt header, content lines, bars */}
      <g data-fx="report">
        <rect x="547" y="127" width="120" height="190" class="fill-ink" />
        <rect x="540" y="120" width="120" height="190" class="fill-white stroke-ink" stroke-width="4" />
        <rect x="542" y="122" width="116" height="30" class="fill-cobalt" />
        <text x="600" y="143" text-anchor="middle" class="fill-white text-[14px] font-bold uppercase tracking-wide">
          {labels.report}
        </text>
        <path d="M556 172 H644 M556 188 H628" class="stroke-ink" stroke-width="3" opacity="0.3" />
        <rect x="556" y="244" width="16" height="44" class="fill-cobalt" />
        <rect x="580" y="224" width="16" height="64" class="fill-cobalt" />
        <rect x="604" y="204" width="16" height="84" class="fill-cobalt" />
        <path d="M630 262 l8 10 14 -20" class="stroke-cobalt" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" fill="none" />
      </g>

      {/* Flowing data dots (CSS loop; hidden when offset-path is unsupported) */}
      {
        Object.values(paths).map((d) =>
          [0, 1].map((k) => (
            <circle
              r="7"
              class="flow-dot fill-cobalt"
              style={`offset-path: path('${d}'); animation-delay: ${(k * -1.5).toFixed(1)}s;`}
            />
          )),
        )
      }
    </svg>
  </div>
</SceneShell>
