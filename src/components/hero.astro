---
// Hero: asymmetric split — display value prop left, real product shots right
// (CallWise dominant + odbiera.ai chip with the semantic "live" square),
// closed by the full-bleed ink trust strip. Only true facts, no invented numbers.
import Icon from "@/components/icon.astro";
import { getCompanyHome } from "@/data/company-home";
import type { Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = getCompanyHome(locale);
const mainShot = `/projects/callwise-${locale}.webp`;
const chipShot = `/projects/odbiera-${locale}.webp`;
---

<section class="bg-offwhite">
  <div class="mx-auto max-w-6xl px-6 pb-16 pt-24 md:pb-20 md:pt-28">
    <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-14">
      <div>
        <h1
          class="font-display text-4xl uppercase leading-[0.98] tracking-tight text-ink [text-wrap:balance] md:text-6xl lg:text-7xl"
        >
          {i.hero.title}
        </h1>
        <p class="mt-6 max-w-[44ch] text-lg font-medium leading-normal text-ink">{i.hero.subtitle}</p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href="#kontakt" class="btn-primary">
            {i.hero.primaryCta}
            <Icon name="arrow-right" class="h-4 w-4" />
          </a>
          <a href="#produkty" class="btn-ghost">{i.hero.secondaryCta}</a>
        </div>
      </div>

      {/* Hero asset: real screenshots in hard 3px frames */}
      <div class="relative mx-auto w-full max-w-[34rem] pb-10 pl-6 lg:mx-0 lg:max-w-none">
        <div class="border-[3px] border-ink bg-white">
          <img
            src={mainShot}
            alt={i.hero.mainShotAlt}
            width="1280"
            height="720"
            class="aspect-[16/10] w-full object-cover object-top"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <div class="absolute -bottom-2 left-0 w-[46%] border-[3px] border-ink bg-white">
          <img
            src={chipShot}
            alt={i.hero.chipShotAlt}
            width="1280"
            height="720"
            class="aspect-[16/9] w-full object-cover object-top"
            loading="eager"
          />
          <p
            class="flex items-center gap-2 border-t-[3px] border-ink px-3 py-2 text-[10px] font-bold uppercase tracking-[0.14em] text-ink"
          >
            <span class="status-dot"></span>
            {i.hero.liveLabel}
          </p>
        </div>
      </div>
    </div>
  </div>

  {/* Trust strip: real facts only, full-bleed ink band */}
  <div class="border-t-[3px] border-ink bg-ink">
    <ul
      class="mx-auto flex max-w-6xl flex-col px-6 py-3 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-10 sm:py-0"
    >
      {
        i.hero.trust.map((fact) => (
          <li class="py-1 text-xs font-bold uppercase tracking-[0.1em] text-offwhite sm:py-4">{fact}</li>
        ))
      }
    </ul>
  </div>
</section>
