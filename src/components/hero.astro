---
// Hero (brutal blok): full-bleed two-column grid split by a 3px rule.
// Right: a numbered index — 00 Intro plus the five services. Left: the
// panel the index controls; Intro holds the headline, each service row
// swaps in its name, description, proof, and robot. This IS the services
// surface (#uslugi) — there is no separate section. Closed by the
// full-bleed ink trust strip. Only true facts, no invented numbers.
import Icon from "@/components/icon.astro";
import { getCompanyHome } from "@/data/company-home";
import type { Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = getCompanyHome(locale);
const rows = [{ label: "Intro" }, ...i.services.items.map((item) => ({ label: item.name }))];
---

{/* Desktop: the wrapper is one viewport per index entry; the hero pins inside
    it and scroll walks the index (sentinels + IO, no wheel hijack). After the
    last entry the pin releases and the page scrolls on. Mobile: no pinning. */}
<section id="uslugi" data-hero-root class="relative scroll-mt-[51px] lg:h-[350svh]">
  <div class="pointer-events-none absolute inset-x-0 top-0 hidden lg:block" aria-hidden="true">
    {rows.map((_, idx) => <div data-hero-sentinel data-idx={idx} class="h-[50svh]" />)}
  </div>
  {/* pt-[51px] = exact height of the fixed top bar (24px logo + 2x12px padding + 3px border) */}
  <div class="flex flex-col bg-offwhite pt-[51px] lg:sticky lg:top-0 lg:h-[100svh]">
  <div class="grid flex-1 lg:min-h-0 lg:grid-cols-[3fr_2fr]">
    {/* Left: the swapping panel (Intro by default) + the persistent CTA */}
    <div
      class="flex flex-col items-start justify-center gap-7 px-6 py-16 md:py-20 lg:gap-8 lg:border-r-[3px] lg:border-ink lg:px-10"
    >
      <div data-hero-panels class="w-full" aria-live="polite">
        <div data-hero-panel data-idx="0" class="flex flex-col gap-7 lg:gap-8">
          <h1
            class="font-display text-5xl uppercase leading-[0.98] tracking-tight text-ink [text-wrap:balance] md:text-6xl lg:text-[clamp(4.5rem,6.4vw,5.75rem)]"
          >
            {i.hero.title}
          </h1>
          <p class="max-w-[44ch] text-lg font-medium leading-normal text-ink">{i.hero.subtitle}</p>
        </div>
        {
          i.services.items.map((item, k) => (
            <div data-hero-panel data-idx={k + 1} hidden class="grid w-full items-center gap-8 lg:grid-cols-[1fr_auto]">
              <div class="flex flex-col items-start gap-5">
                <p class="font-display text-lg text-cobalt" aria-hidden="true">
                  {String(k + 1).padStart(2, "0")}
                </p>
                <h2 class="font-display text-4xl uppercase leading-[1.02] tracking-tight text-ink md:text-5xl">
                  {item.name}
                </h2>
                <p class="max-w-[44ch] text-lg font-medium leading-normal text-ink">{item.text}</p>
                {item.id === "chat" ? (
                  <button
                    type="button"
                    data-open-chat
                    class="text-left text-base font-bold text-ink underline decoration-cobalt decoration-[3px] underline-offset-4 hover:text-cobalt"
                  >
                    {item.proofLabel}
                  </button>
                ) : item.proofHref ? (
                  <a
                    href={item.proofHref}
                    target="_blank"
                    rel="noopener"
                    class="inline-flex items-center gap-1.5 text-base font-bold text-ink underline decoration-cobalt decoration-[3px] underline-offset-4 hover:text-cobalt"
                  >
                    {item.proofLabel}
                    <Icon name="external-link" class="h-3.5 w-3.5 flex-none" />
                  </a>
                ) : (
                  <p class="text-base font-bold text-ink">{item.proofLabel}</p>
                )}
              </div>
              <img
                src={item.image}
                alt={item.imageAlt}
                class="hidden h-64 w-auto lg:block xl:h-72"
                loading="lazy"
                decoding="async"
              />
            </div>
          ))
        }
      </div>
      <a href="#kontakt" class="btn-primary">
        {i.hero.primaryCta}
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </div>

    {/* Right: the index driving the left panel */}
    <div class="flex flex-col border-t-[3px] border-ink lg:border-t-0" role="list" aria-label={i.services.title}>
      {
        rows.map((row, idx) => (
          <button
            type="button"
            data-hero-tab
            data-idx={idx}
            aria-current={idx === 0 ? "true" : "false"}
            class:list={[
              "hero-row flex flex-1 items-center gap-3 px-6 py-4 text-left lg:gap-4 lg:px-8 lg:py-0",
              idx < rows.length - 1 && "border-b-[3px] border-ink",
            ]}
          >
            <span class="font-display text-base lg:text-lg" aria-hidden="true">
              {String(idx).padStart(2, "0")}
            </span>
            <span class="text-lg font-bold lg:text-xl">{row.label}</span>
          </button>
        ))
      }
    </div>
  </div>

  {/* Trust strip: real facts only, full-bleed ink band */}
  <ul class="flex flex-col border-t-[3px] border-ink bg-ink py-3 sm:flex-row sm:py-0">
    {
      i.hero.trust.map((fact) => (
        <li class="px-6 py-1 text-xs font-bold uppercase tracking-[0.1em] text-offwhite sm:py-4 lg:px-10">
          {fact}
        </li>
      ))
    }
  </ul>
  </div>
</section>

<style>
  /* Row states: idle white, hover inverts to ink; the active row sits cobalt. */
  .hero-row {
    background: #ffffff;
    color: var(--color-ink);
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }

  .hero-row:hover {
    background: var(--color-ink);
    color: #ffffff;
  }

  .hero-row[aria-current="true"] {
    background: var(--color-cobalt);
    color: #ffffff;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-row {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-hero-root]").forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-hero-tab]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-hero-panel]")];
    const host = root.querySelector<HTMLElement>("[data-hero-panels]")!;
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    const sentinels = [...root.querySelectorAll<HTMLElement>("[data-hero-sentinel]")];
    const pinned = window.matchMedia("(min-width: 1024px)").matches;

    const activate = (idx: number) => {
      tabs.forEach((tab, j) => tab.setAttribute("aria-current", j === idx ? "true" : "false"));
      panels.forEach((panel) => {
        panel.hidden = Number(panel.dataset.idx) !== idx;
      });
    };

    // Clicking a row jumps the scroll position to that entry's sentinel, so
    // click and scroll stay one mechanism on desktop; mobile swaps in place.
    const goTo = (idx: number) => {
      if (pinned) {
        // Half-viewport steps; land the target sentinel's center in the IO band.
        const rootTop = root.getBoundingClientRect().top + window.scrollY;
        const top = Math.max(rootTop, rootTop + (idx * 0.5 - 0.25) * window.innerHeight + 8);
        window.scrollTo({ top, behavior: reducedMotion.matches ? "auto" : "smooth" });
      } else {
        activate(idx);
        host.scrollIntoView({ block: "nearest", behavior: reducedMotion.matches ? "auto" : "smooth" });
      }
    };

    if (pinned) {
      // Scroll drives the index: a sentinel crossing the viewport's middle
      // band activates its entry (no wheel hijack, native scrolling only).
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) activate(Number((entry.target as HTMLElement).dataset.idx));
          });
        },
        { rootMargin: "-45% 0px -45% 0px" }
      );
      sentinels.forEach((sentinel) => io.observe(sentinel));
    }

    tabs.forEach((tab, idx) => {
      tab.addEventListener("click", () => goTo(idx));
      tab.addEventListener("keydown", (event) => {
        const delta =
          event.key === "ArrowDown" || event.key === "ArrowRight"
            ? 1
            : event.key === "ArrowUp" || event.key === "ArrowLeft"
              ? -1
              : 0;
        if (!delta) return;
        event.preventDefault();
        const next = (idx + delta + tabs.length) % tabs.length;
        tabs[next].focus();
        goTo(next);
      });
    });
    activate(0);
  });
</script>
