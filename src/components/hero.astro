---
// Hero: the Blueprint artboard composition. Left: mono eyebrow, H1,
// subtext, two CTAs. Right: a HUD-framed interactive service terminal
// (command list + the active service's output with a small glowing
// robot) — this frame IS the services section (#uslugi). A full-bleed
// mono trust strip on a hairline closes the viewport-height scene.
import Icon from "@/components/icon.astro";
import { getCompanyHome } from "@/data/company-home";
import type { Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = getCompanyHome(locale);
const termCmd = locale === "en" ? "services --list" : "uslugi --lista";
---

<section class="relative flex flex-col lg:min-h-[100dvh]">
  <div class="mx-auto flex w-full max-w-6xl flex-1 items-center px-6 pb-14 pt-28 lg:pb-12 lg:pt-32">
    <div class="grid w-full items-center gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-14">
      {/* Left: value prop */}
      <div>
        <p class="font-mono text-xs text-primary md:text-[13px]">{i.hero.eyebrow}</p>
        <h1
          class="mt-6 text-5xl font-bold leading-[1.04] tracking-tight text-white [text-wrap:balance] md:text-6xl lg:text-7xl"
        >
          {i.hero.title}
        </h1>
        <p class="mt-5 max-w-[46ch] text-lg leading-relaxed text-white/65">{i.hero.subtitle}</p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="#kontakt" class="btn-primary">
            {i.hero.primaryCta}
            <Icon name="arrow-right" class="h-4 w-4" />
          </a>
          <a href="#produkty" class="btn-ghost">{i.hero.secondaryCta}</a>
        </div>
      </div>

      {/* Right: interactive service terminal — the services section itself,
          so the #uslugi nav anchor lands here. */}
      <div
        id="uslugi"
        data-scene-root
        role="region"
        aria-label={i.services.title}
        class="term hud-corners relative scroll-mt-24"
      >
        <div class="term-bar">
          <span class="font-mono text-[11px] font-semibold tracking-[0.08em] text-white/40">$ {termCmd}</span>
        </div>

        <div class="term-body p-4 md:p-6">
          {/* Command list: vertical on desktop, horizontal scroll on mobile */}
          <div class="flex gap-1 overflow-x-auto pb-2 lg:flex-col lg:overflow-visible lg:pb-0" role="list">
            {
              i.services.items.map((item, idx) => (
                <button
                  type="button"
                  data-scene-tab
                  data-idx={idx}
                  aria-current={idx === 0 ? "true" : "false"}
                  class="term-line flex flex-none items-baseline gap-2.5 px-3.5 py-2.5 text-left font-mono"
                >
                  <span class="term-prompt text-xs" aria-hidden="true">
                    {String(idx + 1).padStart(2, "0")}
                  </span>
                  <span class="text-[13px] font-semibold tracking-tight">{item.name}</span>
                  <span class="term-cursor" aria-hidden="true" />
                </button>
              ))
            }
          </div>

          {/* Output of the active command: robot crossfade + description */}
          <div class="mt-4 border-t border-primary/20 pt-4 md:mt-5 md:pt-5">
            <div class="grid gap-5 sm:grid-cols-[auto_1fr] sm:items-center sm:gap-6">
              <div class="scene-stage grid place-items-center">
                {
                  i.services.items.map((item, idx) => (
                    <img
                      data-scene-img
                      src={item.image}
                      alt={item.imageAlt || item.name}
                      class="scene-img"
                      style={idx === 0 ? "opacity:1" : "opacity:0"}
                      loading={idx === 0 ? "eager" : "lazy"}
                      decoding="async"
                    />
                  ))
                }
              </div>
              <div>
                {
                  i.services.items.map((item, idx) => {
                    const proofClass =
                      "mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-primary underline decoration-primary/40 underline-offset-4 hover:decoration-primary";
                    return (
                      <div data-scene-panel data-idx={idx} hidden={idx !== 0}>
                        <p class="max-w-[46ch] text-sm leading-relaxed text-white/65 md:text-[15px]">{item.text}</p>
                        {item.id === "chat" ? (
                          <button type="button" data-open-chat class:list={[proofClass, "text-left"]}>
                            {item.proofLabel}
                            <Icon name="message-circle" class="h-3.5 w-3.5 flex-none" />
                          </button>
                        ) : item.proofHref ? (
                          <a href={item.proofHref} target="_blank" rel="noopener" class={proofClass}>
                            {item.proofLabel}
                            <Icon name="external-link" class="h-3.5 w-3.5 flex-none" />
                          </a>
                        ) : (
                          <p class="mt-4 text-sm font-medium text-white/65">{item.proofLabel}</p>
                        )}
                      </div>
                    );
                  })
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  {/* Trust strip: real facts only, mono brackets on a full-bleed hairline */}
  <div class="border-t border-primary/20">
    <ul
      class="mx-auto flex w-full max-w-6xl flex-col gap-2 px-6 py-5 font-mono text-xs font-medium uppercase tracking-[0.12em] text-white/45 sm:flex-row sm:flex-wrap sm:gap-x-10 sm:gap-y-2"
    >
      {i.hero.trust.map((fact) => <li>[ {fact} ]</li>)}
    </ul>
  </div>
</section>

<style>
  /* HUD-framed terminal panel on the page ground. */
  .term {
    border: 1px solid var(--line-strong);
    background: var(--surface);
  }

  .term-bar {
    display: flex;
    align-items: center;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--line-soft);
    background: rgba(59, 130, 255, 0.05);
  }

  /* Denser grid inside the session than the page's 48px ground. */
  .term-body {
    background-image:
      linear-gradient(to right, rgba(59, 130, 255, 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(59, 130, 255, 0.05) 1px, transparent 1px);
    background-size: 34px 34px;
  }

  .term-line {
    color: rgb(255 255 255 / 0.6);
    border-left: 2px solid transparent;
    transition: color 0.2s ease, background 0.2s ease, border-color 0.2s ease;
  }

  .term-line:hover {
    color: #ffffff;
  }

  .term-prompt {
    color: var(--color-accent);
  }

  .term-line[aria-current="true"] {
    background: rgba(59, 130, 255, 0.12);
    border-left-color: var(--color-accent);
    color: #ffffff;
  }

  /* Block cursor blinks only on the active command line. */
  .term-cursor {
    display: none;
    width: 0.5em;
    height: 1em;
    align-self: center;
    background: var(--color-accent);
  }

  .term-line[aria-current="true"] .term-cursor {
    display: inline-block;
    animation: term-blink 1.1s steps(1) infinite;
  }

  @keyframes term-blink {
    50% {
      opacity: 0;
    }
  }

  /* Output stage: small robot, accent glow, stable height across swaps. */
  .scene-stage {
    min-height: 8.5rem;
  }

  .scene-img {
    grid-area: 1 / 1;
    max-height: min(24vh, 8.5rem);
    width: auto;
    transition: opacity 0.45s ease;
    filter: drop-shadow(0 16px 32px rgba(59, 130, 255, 0.3));
  }

  @media (prefers-reduced-motion: reduce) {
    .term-line,
    .scene-img {
      transition: none;
    }

    .term-line[aria-current="true"] .term-cursor {
      animation: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-scene-root]").forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-scene-tab]")];
    const imgs = [...root.querySelectorAll<HTMLElement>("[data-scene-img]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-scene-panel]")];

    const activate = (idx: number) => {
      tabs.forEach((tab, j) => tab.setAttribute("aria-current", j === idx ? "true" : "false"));
      imgs.forEach((img, j) => {
        img.style.opacity = j === idx ? "1" : "0";
      });
      panels.forEach((panel, j) => {
        panel.hidden = j !== idx;
      });
    };

    tabs.forEach((tab, idx) => {
      tab.addEventListener("click", () => activate(idx));
      tab.addEventListener("keydown", (event) => {
        const delta =
          event.key === "ArrowDown" || event.key === "ArrowRight"
            ? 1
            : event.key === "ArrowUp" || event.key === "ArrowLeft"
              ? -1
              : 0;
        if (!delta) return;
        event.preventDefault();
        const next = (idx + delta + tabs.length) % tabs.length;
        tabs[next].focus();
        activate(next);
      });
    });
  });
</script>
