---
// Services, variant B ("interactive cascade"): five slanted cards stepping
// down the family diagonal, robots leaning out of the corners; hover lifts a
// card and grows its robot. Mobile collapses to a plain full-width stack.
import Icon from "@/components/icon.astro";
import { getCompanyHome } from "@/data/company-home";
import type { Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = getCompanyHome(locale);
---

<section id="uslugi-b" class="scroll-mt-24 overflow-x-clip bg-white py-20 md:py-24">
  <div class="mx-auto max-w-6xl px-6">
    <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-band-strong">[ wariant B · kaskada ]</p>
    <div class="animate-on-scroll mt-3">
      <h2 class="text-3xl font-bold tracking-tight text-ink md:text-4xl">{i.services.title}</h2>
      <p class="mt-3 max-w-[60ch] text-base leading-relaxed text-muted md:text-lg">{i.services.subtitle}</p>
    </div>

    <div class="mt-10 md:mt-14">
      {
        i.services.items.map((item, idx) => {
          const onBlue = idx % 2 === 0;
          const proofClass = onBlue
            ? "mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-white underline decoration-white/40 underline-offset-4 hover:decoration-white"
            : "mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-primary-deep hover:text-primary";
          return (
            <div class="csc-wrap animate-on-scroll" style={`--i:${idx}`}>
              <img
                src={item.image}
                alt={item.imageAlt || item.name}
                class="csc-art"
                loading="lazy"
                decoding="async"
              />
              <div class:list={["csc-card", onBlue ? "csc-blue" : "csc-light"]}>
                <h3 class:list={["text-lg font-bold tracking-tight md:text-xl", onBlue ? "text-white" : "text-ink"]}>
                  {item.name}
                </h3>
                <p class:list={["mt-2 max-w-[46ch] text-[14px] leading-relaxed md:text-[15px]", onBlue ? "text-white/90" : "text-muted"]}>
                  {item.text}
                </p>
                {item.id === "chat" ? (
                  <button type="button" data-open-chat class:list={[proofClass, "self-start text-left"]}>
                    {item.proofLabel}
                    <Icon name="message-circle" class="h-3.5 w-3.5 flex-none" />
                  </button>
                ) : item.proofHref ? (
                  <a href={item.proofHref} target="_blank" rel="noopener" class={proofClass}>
                    {item.proofLabel}
                    <Icon name="external-link" class="h-3.5 w-3.5 flex-none" />
                  </a>
                ) : (
                  <p class:list={["mt-4 text-sm font-medium", onBlue ? "text-white/80" : "text-muted"]}>{item.proofLabel}</p>
                )}
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .csc-wrap {
    position: relative;
  }

  .csc-card {
    clip-path: polygon(0 0, 100% 0.9rem, 100% 100%, 0 calc(100% - 0.9rem));
    padding: 2.4rem 2rem;
  }

  .csc-blue {
    background-image: linear-gradient(120deg, var(--color-primary) 0%, var(--color-primary-deep) 85%);
  }

  .csc-light {
    background: var(--color-band);
  }

  /* Mobile: plain stack, artwork above the card. */
  .csc-art {
    display: block;
    margin: 0 auto 1.25rem;
    max-height: 11rem;
    width: auto;
    filter: drop-shadow(0 16px 24px color-mix(in srgb, var(--color-dark) 22%, transparent));
  }

  .csc-wrap + .csc-wrap {
    margin-top: 2rem;
  }

  @media (min-width: 1024px) {
    /* Staircase down the family diagonal: each card steps right and tucks
     * under the previous one; the robot leans out of the outer corner. */
    .csc-wrap {
      width: 46%;
      margin-left: calc(var(--i) * 13.5%);
      transition: transform 0.25s ease;
    }

    .csc-wrap + .csc-wrap {
      margin-top: -2.25rem;
    }

    .csc-wrap:hover {
      transform: translateY(-4px);
      z-index: 20;
    }

    .csc-card {
      padding-right: 8.5rem;
    }

    .csc-art {
      position: absolute;
      top: 50%;
      right: -3.25rem;
      z-index: 10;
      margin: 0;
      max-height: 12.5rem;
      transform: translateY(-50%);
      transition: transform 0.25s ease;
      pointer-events: none;
    }

    .csc-wrap:hover .csc-art {
      transform: translateY(-50%) scale(1.06);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .csc-wrap,
    .csc-art {
      transition: none;
    }

    .csc-wrap:hover {
      transform: none;
    }

    .csc-wrap:hover .csc-art {
      transform: translateY(-50%);
    }
  }
</style>
