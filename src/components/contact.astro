---
// Contact: the page's single conversion point. Ink closing block, white form
// block, "what happens next" beside it, email as fallback.
// POST goes to the shared public contact endpoint (lead lands in CallWise);
// the `page` field tells the backend it came from awesomeworks.ai.
import Icon from "@/components/icon.astro";
import { getCompanyHome, privacyPath } from "@/data/company-home";
import type { Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = getCompanyHome(locale);
const c = i.contact;
const privacyHref = privacyPath(locale);

const formI18n = {
  submit: c.form.submit,
  submitLoading: c.form.submitLoading,
  errors: c.form.errors,
};

const field =
  "mt-1.5 h-12 w-full border-[3px] border-ink bg-white px-4 text-[0.95rem] text-ink placeholder:text-ink/60 focus:border-cobalt focus:outline-none";
const label = "block text-sm font-bold text-ink";
---

<section id="kontakt" class="scroll-mt-16 bg-ink pb-20 pt-16 md:pb-24 md:pt-20">
  <div class="mx-auto max-w-6xl px-6">
    {/* Mobile stacks in conversion order (header → form → next steps → email);
        on lg the form block spans both rows of the right column. */}
    <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:grid-rows-[auto_1fr] lg:items-start lg:gap-x-16 lg:gap-y-10">
      <div class="lg:col-start-1 lg:row-start-1 lg:pt-6">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-offwhite">{c.eyebrow}</p>
        <h2 class="mt-5 max-w-xl font-display text-3xl uppercase tracking-tight text-white md:text-5xl">{c.title}</h2>
        <p class="mt-4 max-w-xl text-lg leading-relaxed text-offwhite">{c.subtitle}</p>
      </div>

      <div class="bg-white p-6 md:p-8 lg:col-start-2 lg:row-start-1 lg:row-span-2">
        <form class="contact-form" novalidate data-contact-form>
          <script is:inline type="application/json" data-contact-i18n set:html={JSON.stringify(formI18n)} />
          <div class="grid gap-5 sm:grid-cols-2">
            <label class="sm:col-span-2">
              <span class={label}>{c.form.name} <span aria-hidden="true">*</span></span>
              <input type="text" name="name" autocomplete="name" required class={field} />
            </label>
            <label class="sm:col-span-2">
              <span class={label}>{c.form.company}</span>
              <input
                type="text"
                name="company"
                autocomplete="organization"
                placeholder={c.form.companyPlaceholder}
                class={field}
              />
            </label>
            <label>
              <span class={label}>{c.form.phone} <span aria-hidden="true">*</span></span>
              <input type="tel" name="phone" inputmode="tel" autocomplete="tel" placeholder="+48 600 000 000" required class={field} />
            </label>
            <label>
              <span class={label}>{c.form.email} <span aria-hidden="true">*</span></span>
              <input type="email" name="email" autocomplete="email" required class={field} />
            </label>
            <label class="sm:col-span-2">
              <span class={label}>{c.form.message}</span>
              <textarea name="message" rows="4" placeholder={c.form.messagePlaceholder} class:list={[field, "h-auto py-3"]}
              ></textarea>
            </label>
          </div>
          {/* Honeypot — bots fill it and get a fake success from the backend. */}
          <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="hp-field" />

          <button type="submit" class="btn-primary mt-6 w-full sm:w-auto">
            <Icon name="arrow-right" class="h-4 w-4" />
            <span class="btn-dot hidden" data-contact-dot aria-hidden="true"></span>
            <span data-contact-label>{c.form.submit}</span>
          </button>
          <p class="mt-3 text-xs leading-snug text-ink">
            {c.form.consentPre}<a
              href={privacyHref}
              class="underline decoration-cobalt underline-offset-2 hover:text-cobalt">{c.form.consentLink}</a
            >.
          </p>
          <p
            class="mt-4 hidden bg-cobalt px-4 py-3 text-sm font-bold leading-snug text-white"
            data-contact-success
            role="status"
            aria-live="polite"
          >
            {c.form.success}
          </p>
          <p
            class="mt-4 hidden border-[3px] border-ink px-4 py-3 text-sm font-bold leading-snug text-ink"
            data-contact-error
            role="alert"
            aria-live="polite"
          >
          </p>
        </form>
      </div>

      <div class="lg:col-start-1 lg:row-start-2">
        <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-white">
          {c.nextTitle}
        </p>
        <ol class="mt-4 max-w-xl space-y-3">
          {
            c.next.map((step, idx) => (
              <li class="flex items-start gap-3">
                <span class="grid h-8 w-8 flex-none place-items-center border-[3px] border-white font-display text-xs text-white">
                  {String(idx + 1).padStart(2, "0")}
                </span>
                <span class="text-[0.95rem] leading-relaxed text-offwhite">{step}</span>
              </li>
            ))
          }
        </ol>

        <p class="mt-8 text-sm text-offwhite">
          {c.altLabel}
          <a
            href={`mailto:${c.email}?subject=AwesomeWorks`}
            class="ml-1 inline-flex items-center gap-1.5 font-bold text-white underline underline-offset-4"
          >
            <Icon name="mail" class="h-4 w-4" />
            {c.email}
          </a>
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  const API_BASE = (
    import.meta.env.PUBLIC_AWESOMEBOT_API_BASE || "https://app.odbiera.ai/api"
  ).replace(/\/+$/, "");
  const FETCH_TIMEOUT_MS = 12_000;

  type ErrorKey = "required" | "email" | "phone" | "capacity" | "generic";

  const ERROR_KEY_BY_CODE: Record<string, ErrorKey> = {
    invalid_email: "email",
    invalid_phone: "phone",
    missing_fields: "required",
    ip_daily_limit: "capacity",
    daily_cap_reached: "capacity",
  };

  document.querySelectorAll<HTMLFormElement>("[data-contact-form]").forEach((form) => {
    const i18n = JSON.parse(form.querySelector("[data-contact-i18n]")?.textContent ?? "{}") as {
      submit: string;
      submitLoading: string;
      errors: Record<ErrorKey, string>;
    };

    const button = form.querySelector<HTMLButtonElement>("button[type='submit']");
    const icon = button?.querySelector("svg");
    const dot = button?.querySelector<HTMLElement>("[data-contact-dot]");
    const label = button?.querySelector<HTMLElement>("[data-contact-label]");
    const success = form.querySelector<HTMLElement>("[data-contact-success]");
    const error = form.querySelector<HTMLElement>("[data-contact-error]");
    const value = (name: string) => (form.elements.namedItem(name) as HTMLInputElement | null)?.value.trim() ?? "";

    const setBusy = (busy: boolean) => {
      icon?.classList.toggle("hidden", busy);
      dot?.classList.toggle("hidden", !busy);
      dot?.classList.toggle("inline-block", busy);
      if (label) label.textContent = busy ? i18n.submitLoading : i18n.submit;
      if (button) button.disabled = busy;
      button?.setAttribute("aria-busy", String(busy));
    };

    const showError = (key: ErrorKey) => {
      success?.classList.add("hidden");
      if (error) {
        error.textContent = i18n.errors[key];
        error.classList.remove("hidden");
      }
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (button?.disabled) return;

      const name = value("name");
      const phone = value("phone");
      const email = value("email");
      if (!name || !phone || !email) return showError("required");
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return showError("email");
      if (phone.replace(/\D/g, "").length < 9) return showError("phone");

      error?.classList.add("hidden");
      setBusy(true);
      const controller = new AbortController();
      const timeout = setTimeout(() => controller.abort(), FETCH_TIMEOUT_MS);
      try {
        const res = await fetch(`${API_BASE}/v1/public/contact`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            name,
            company: value("company"),
            phone,
            email,
            message: value("message"),
            locale: document.documentElement.lang === "en" ? "en" : "pl",
            page: window.location.pathname,
            website: value("website"),
          }),
          signal: controller.signal,
        });
        if (res.status === 202) {
          form.querySelectorAll<HTMLElement>("input, textarea, button").forEach((el) => {
            (el as HTMLInputElement).disabled = true;
          });
          success?.classList.remove("hidden");
          success?.scrollIntoView({ block: "nearest", behavior: "smooth" });
          return;
        }
        const body = await res.json().catch(() => null);
        const code = body?.detail?.code;
        showError((typeof code === "string" && ERROR_KEY_BY_CODE[code]) || "generic");
      } catch {
        showError("generic");
      } finally {
        clearTimeout(timeout);
        if (!(button?.disabled && success && !success.classList.contains("hidden"))) setBusy(false);
      }
    });
  });
</script>
