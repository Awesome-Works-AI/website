---
// Locale switch pill (mono, family style) — lives inside the nav pill.
import type { Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
  /** Path of this page in the other locale. */
  altPath: string;
}

const { locale, altPath } = Astro.props;
const altLocale: Locale = locale === "pl" ? "en" : "pl";
---

<a
  href={altPath}
  class="inline-flex h-9 items-center rounded-full px-3 font-mono text-[11px] font-semibold tracking-wide text-primary-deep transition hover:bg-band hover:text-dark"
  aria-label={altLocale === "en" ? "Switch to English" : "Przełącz na polski"}
>
  {altLocale.toUpperCase()}
</a>
