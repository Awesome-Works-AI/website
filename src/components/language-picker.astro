---
// Locale switch (mono, Blueprint style) — lives inside the HUD nav bar.
import type { Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
  /** Path of this page in the other locale. */
  altPath: string;
}

const { locale, altPath } = Astro.props;
const altLocale: Locale = locale === "pl" ? "en" : "pl";
---

<a
  href={altPath}
  class="inline-flex h-9 items-center px-3 font-mono text-[11px] font-semibold tracking-wide text-primary transition hover:bg-primary/10 hover:text-white"
  aria-label={altLocale === "en" ? "Switch to English" : "Przełącz na polski"}
>
  {altLocale.toUpperCase()}
</a>
