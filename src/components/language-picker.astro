---
// Locale switch segment (brutal block) — lives inside the top bar.
import type { Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
  /** Path of this page in the other locale. */
  altPath: string;
}

const { locale, altPath } = Astro.props;
const altLocale: Locale = locale === "pl" ? "en" : "pl";
---

<a
  href={altPath}
  class="flex items-center border-l-[3px] border-ink px-3 text-[13px] font-bold uppercase tracking-wide text-ink transition-colors hover:bg-ink hover:text-white md:px-4"
  aria-label={altLocale === "en" ? "Switch to English" : "Przełącz na polski"}
>
  {altLocale.toUpperCase()}
</a>
