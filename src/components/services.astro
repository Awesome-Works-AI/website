---
// Services: a rail of five slanted panels ("rhombi") bleeding off alternating
// screen edges — a blue panel with white text, then a white panel with ink
// text. Each panel keeps a media slot for per-service artwork (PNG); until the
// artwork lands, the service icon holds the slot. Panels are not clickable;
// only the proof links/buttons inside them are interactive.
import Icon from "@/components/icon.astro";
import { getCompanyHome } from "@/data/company-home";
import type { Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = getCompanyHome(locale);
---

<section id="uslugi" class="scroll-mt-24 overflow-x-clip bg-white py-20 md:py-24">
  <div class="mx-auto max-w-6xl px-6">
    <div class="animate-on-scroll">
      <h2 class="text-3xl font-bold tracking-tight text-ink md:text-4xl">{i.services.title}</h2>
      <p class="mt-3 max-w-[60ch] text-base leading-relaxed text-muted md:text-lg">{i.services.subtitle}</p>
    </div>
  </div>

  <div class="mt-10 space-y-8 md:mt-14 md:space-y-10">
    {
      i.services.items.map((item, idx) => {
        const fromLeft = idx % 2 === 0;
        const onBlue = fromLeft;
        const proofInteractive = onBlue
          ? "mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-white underline decoration-white/40 underline-offset-4 hover:decoration-white"
          : "mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-primary-deep hover:text-primary";
        return (
          <article
            class:list={[
              "svc-panel animate-on-scroll",
              fromLeft ? "svc-left" : "svc-right",
              onBlue ? "svc-blue" : "svc-light",
            ]}
          >
            <div class="svc-inner md:grid md:grid-cols-[1.1fr_0.9fr] md:items-center md:gap-12">
              <div class:list={[!fromLeft && "md:order-2"]}>
                <h3 class:list={["text-xl font-bold tracking-tight md:text-2xl", onBlue ? "text-white" : "text-ink"]}>
                  {item.name}
                </h3>
                <p
                  class:list={[
                    "mt-3 max-w-[52ch] text-[15px] leading-relaxed md:text-base",
                    onBlue ? "text-white/90" : "text-muted",
                  ]}
                >
                  {item.text}
                </p>
                {item.id === "chat" ? (
                  <button type="button" data-open-chat class:list={[proofInteractive, "text-left"]}>
                    {item.proofLabel}
                    <Icon name="message-circle" class="h-3.5 w-3.5 flex-none" />
                  </button>
                ) : item.proofHref.startsWith("http") ? (
                  <a href={item.proofHref} target="_blank" rel="noopener" class={proofInteractive}>
                    {item.proofLabel}
                    <Icon name="external-link" class="h-3.5 w-3.5 flex-none" />
                  </a>
                ) : item.proofHref ? (
                  <a href={item.proofHref} class={proofInteractive}>
                    {item.proofLabel}
                    <Icon name="arrow-right" class="h-3.5 w-3.5 flex-none" />
                  </a>
                ) : (
                  <p class:list={["mt-6 text-sm font-medium", onBlue ? "text-white/80" : "text-muted"]}>
                    {item.proofLabel}
                  </p>
                )}
              </div>
              <div
                class:list={[
                  "mt-8 flex items-center justify-center md:mt-0",
                  !fromLeft && "md:order-1",
                  onBlue ? "text-white/80" : "text-primary",
                ]}
              >
                {item.image ? (
                  <img
                    src={item.image}
                    alt={item.imageAlt || item.name}
                    class="max-h-56 w-auto md:max-h-64"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <Icon name={item.icon} class="h-16 w-16 md:h-20 md:w-20" />
                )}
              </div>
            </div>
          </article>
        );
      })
    }
  </div>
</section>
