---
// Process: 4 steps in one bordered grid, divided by 3px rules (columns on
// desktop, stacked rows on mobile). Step 1 lowers the entry threshold;
// step 4 leans on the product-company edge. One repeated primary CTA closes.
import Icon from "@/components/icon.astro";
import { getCompanyHome } from "@/data/company-home";
import type { Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = getCompanyHome(locale);
---

<section id="proces" class="scroll-mt-16 border-b-[3px] border-ink bg-white py-20 md:py-24">
  <div class="mx-auto max-w-6xl px-6">
    <h2 class="font-display text-3xl uppercase tracking-tight text-ink md:text-4xl">{i.process.title}</h2>

    <ol class="mt-12 grid border-[3px] border-ink md:grid-cols-4">
      {
        i.process.steps.map((step, idx) => (
          <li class="border-t-[3px] border-ink p-6 first:border-t-0 md:border-l-[3px] md:border-t-0 md:p-7 md:first:border-l-0">
            <span class="font-display text-4xl text-cobalt" aria-hidden="true">
              {String(idx + 1).padStart(2, "0")}
            </span>
            <h3 class="mt-4 text-lg font-bold tracking-tight text-ink">{step.title}</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-ink">{step.text}</p>
          </li>
        ))
      }
    </ol>

    <div class="mt-12">
      <a href="#kontakt" class="btn-primary">
        {i.process.cta}
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </div>
  </div>
</section>
