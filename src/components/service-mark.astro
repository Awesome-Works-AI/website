---
// Bespoke brand marks ("signal on the slant") — replaces stock icon-library
// glyphs on the service cards and the chat FAB. Shared grammar: every mark is
// built on the family diagonal (descending left → right), carries exactly one
// filled primary "signal dot", and is drawn with a single thin ink stroke.
// Secondary geometry drops to 40% opacity so each mark keeps one focal point.
interface Props {
  name: "voice" | "chat" | "software" | "training" | "chat-plane" | "chat-mini";
  class?: string;
}

const { name, class: className = "h-12 w-12" } = Astro.props;

const marks: Record<string, string> = {
  // Voice: a call line on the slant; the receiver dot radiates three arcs.
  voice: `
    <path d="M4 19 44 31" opacity=".4"/>
    <circle cx="14" cy="22" r="3.2" fill="var(--color-primary)" stroke="none"/>
    <path class="mark-arc" d="M20.5 15.5a9.5 9.5 0 0 1 3 9.5"/>
    <path class="mark-arc" d="M25 11a15.5 15.5 0 0 1 4.5 15"/>
    <path class="mark-arc" d="M29.5 6.5a21.5 21.5 0 0 1 6 20.5"/>`,
  // Chat: two skewed speech planes passing each other on the diagonal;
  // the front one carries the typing dots.
  chat: `
    <path d="M20 11 42 7v10l-22 4Z" opacity=".4"/>
    <path d="M6 22l26-5v12L6 34Z"/>
    <circle cx="14" cy="27.4" r="1.7" fill="var(--color-primary)" stroke="none"/>
    <circle cx="19.5" cy="26.4" r="1.7" fill="currentColor" stroke="none" opacity=".45"/>
    <circle cx="25" cy="25.4" r="1.7" fill="currentColor" stroke="none" opacity=".45"/>`,
  // Software: the family HUD corners with a system edge running between them;
  // one node on the edge, one branch probing off it.
  software: `
    <path d="M6 15V6h9"/>
    <path d="M42 33v9h-9"/>
    <path d="M13 15 35 33" opacity=".4"/>
    <circle cx="24" cy="24" r="3.2" fill="var(--color-primary)" stroke="none"/>
    <path d="m27 21 6.5-5.5"/>
    <circle cx="35.5" cy="14" r="2.2"/>`,
  // Training: the same slant as a skill baseline; dots grow along it until the
  // last one starts transmitting on its own (the voice mark's arcs, inherited).
  training: `
    <path d="M5 19 43 31" opacity=".4"/>
    <circle cx="12" cy="21.2" r="1.7"/>
    <circle cx="23" cy="24.7" r="2.4"/>
    <circle cx="35" cy="28.5" r="3.2" fill="var(--color-primary)" stroke="none"/>
    <path d="M38.5 22.5a8 8 0 0 1 2.5 8"/>
    <path d="M42 18a13 13 0 0 1 4 13" opacity=".4"/>`,
  // Chat FAB: the front speech plane alone, dots in white (sits on primary).
  "chat-plane": `
    <path d="M8 19l32-6v16L8 35Z"/>
    <circle cx="17" cy="26.2" r="2" fill="currentColor" stroke="none"/>
    <circle cx="24" cy="24.9" r="2" fill="currentColor" stroke="none"/>
    <circle cx="31" cy="23.6" r="2" fill="currentColor" stroke="none"/>`,
  // Micro variant for inline links/buttons.
  "chat-mini": `
    <path d="M7 18l34-6v18L7 36Z"/>
    <circle cx="24" cy="26" r="2.6" fill="currentColor" stroke="none"/>`,
};

const body = marks[name] ?? "";
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 48 48"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  set:html={body}
/>
