---
// Google reviews — renders ONLY with live data (the page gates on
// reviews.length > 0; there is no placeholder state by design).
import Icon from "@/components/icon.astro";
import { getGoogleReviewUrl, type GooglePlaceInfo } from "@/data/google-reviews";
import { getCompanyHome } from "@/data/company-home";
import type { Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
  placeInfo: GooglePlaceInfo;
}

const { locale, placeInfo } = Astro.props;
const i = getCompanyHome(locale);
const reviewUrl = getGoogleReviewUrl();
const reviews = placeInfo.reviews.slice(0, 3);
// Typographic quotes per locale (PL low-high, EN high-high).
const qOpen = locale === "pl" ? "„" : "“";
const qClose = "”";
---

<section id="opinie" class="scroll-mt-24 bg-white py-20 md:py-24">
  <div class="mx-auto max-w-6xl px-6">
    <div class="animate-on-scroll">
      <p class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-primary-deep">
        [ {i.reviews.eyebrow} ]
      </p>
      <h2 class="mt-4 text-3xl font-bold tracking-tight text-ink md:text-4xl">{i.reviews.title}</h2>
      <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2">
        <span class="flex items-center gap-1" aria-hidden="true">
          {
            Array.from({ length: 5 }).map((_, idx) => (
              <Icon
                name="star"
                class={`h-4 w-4 ${idx < Math.round(placeInfo.rating) ? "fill-primary text-primary" : "text-band-strong"}`}
              />
            ))
          }
        </span>
        <span class="text-sm font-semibold text-ink">
          {placeInfo.rating.toFixed(1)} {i.reviews.onGoogle} ({placeInfo.totalReviews} {i.reviews.reviewsCount})
        </span>
        <a
          href={reviewUrl}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary-deep hover:text-primary"
        >
          {i.reviews.seeOnGoogle}
          <Icon name="external-link" class="h-3.5 w-3.5" />
        </a>
      </div>
    </div>

    <div class="animate-on-scroll mt-10 grid gap-5 md:grid-cols-3">
      {
        reviews.map((review) => (
          <figure class="flex flex-col rounded-2xl border border-band-strong/40 bg-offwhite p-6">
            <blockquote class="text-[15px] leading-relaxed text-ink [display:-webkit-box] [-webkit-box-orient:vertical] [-webkit-line-clamp:4] overflow-hidden">
              {qOpen}{review.text}{qClose}
            </blockquote>
            <figcaption class="mt-auto flex items-center justify-between gap-3 pt-5">
              <span class="text-sm font-semibold text-ink">{review.authorName}</span>
              <span class="text-xs text-muted">{review.relativeTimeDescription}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
