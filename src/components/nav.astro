---
// Two floating pills (family pattern): logo pill top-left, nav pill top-right
// with section anchors (desktop), locale switch, and the single CTA → #kontakt.
import LanguagePicker from "@/components/language-picker.astro";
import { getCompanyHome } from "@/data/company-home";
import { getLocalePath, type Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
  /** Path of this page in the other locale (defaults to the localized home). */
  altPath?: string;
  /** Legal/sub pages: no section anchors, CTA points at the home contact form. */
  minimal?: boolean;
  /** Adds the #opinie anchor only while the reviews section is live. */
  showReviews?: boolean;
}

const { locale, altPath, minimal = false, showReviews = false } = Astro.props;
const i = getCompanyHome(locale);
const homePath = getLocalePath(locale);
const altLocale: Locale = locale === "pl" ? "en" : "pl";
const resolvedAltPath = altPath ?? getLocalePath(altLocale);
const contactHref = minimal ? `${homePath}#kontakt` : "#kontakt";

const links = showReviews
  ? [...i.nav.links.slice(0, 3), i.nav.reviewsLink, ...i.nav.links.slice(3)]
  : [...i.nav.links];
---

<header
  class="pointer-events-none fixed inset-x-0 top-4 z-50 flex items-center justify-between gap-3 px-4 md:px-6"
  aria-label="Primary"
>
  {/* Logo pill — top-left floating */}
  <a
    href={homePath}
    class="pointer-events-auto inline-flex items-center gap-2 rounded-full border border-band-strong/60 bg-white/85 px-3 py-2 shadow-sm backdrop-blur-md transition hover:bg-white"
  >
    <img src="/logo.png" alt="" width="24" height="24" class="h-6 w-6" />
    <span class="text-sm font-bold tracking-tight text-ink">{i.nav.brand}</span>
  </a>

  {/* Nav pill — top-right floating: anchors + language switch + CTA */}
  <nav
    class="pointer-events-auto inline-flex items-center gap-0.5 rounded-full border border-band-strong/60 bg-white/85 p-1 shadow-sm backdrop-blur-md"
  >
    {
      !minimal &&
        links.map((link) => (
          <a
            href={link.href}
            class="hidden h-9 items-center rounded-full px-3 text-[13px] font-medium text-muted transition hover:bg-band hover:text-ink lg:inline-flex"
          >
            {link.label}
          </a>
        ))
    }
    <LanguagePicker locale={locale} altPath={resolvedAltPath} />
    <a
      href={contactHref}
      class="ml-0.5 inline-flex h-9 items-center rounded-full bg-gradient-to-br from-primary to-primary-deep px-4 text-xs font-semibold text-white shadow-sm transition hover:brightness-95"
    >
      {i.nav.cta}
    </a>
  </nav>
</header>
