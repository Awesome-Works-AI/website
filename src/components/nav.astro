---
// Blueprint HUD bar: one full-width fixed bar on a hairline (accent-tinted)
// with the logo left and mono nav links + locale switch + the single CTA
// (→ #kontakt) right. Desktop shows section anchors.
import LanguagePicker from "@/components/language-picker.astro";
import { getCompanyHome } from "@/data/company-home";
import { getLocalePath, type Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
  /** Path of this page in the other locale (defaults to the localized home). */
  altPath?: string;
  /** Legal/sub pages: no section anchors, CTA points at the home contact form. */
  minimal?: boolean;
  /** Adds the #opinie anchor only while the reviews section is live. */
  showReviews?: boolean;
}

const { locale, altPath, minimal = false, showReviews = false } = Astro.props;
const i = getCompanyHome(locale);
const homePath = getLocalePath(locale);
const altLocale: Locale = locale === "pl" ? "en" : "pl";
const resolvedAltPath = altPath ?? getLocalePath(altLocale);
const contactHref = minimal ? `${homePath}#kontakt` : "#kontakt";

const links = showReviews
  ? [...i.nav.links.slice(0, 3), i.nav.reviewsLink, ...i.nav.links.slice(3)]
  : [...i.nav.links];
---

<header
  class="fixed inset-x-0 top-0 z-50 flex items-center justify-between gap-3 border-b border-primary/20 bg-night/85 px-4 py-3 backdrop-blur-md md:px-6"
  aria-label="Primary"
>
  {/* Wordmark — mono, accent on the second half (Blueprint signature) */}
  <a href={homePath} class="inline-flex items-center gap-2.5">
    <img src="/logo.png" alt="" width="24" height="24" class="h-6 w-6" />
    <span class="font-mono text-sm font-semibold tracking-tight text-white">{i.nav.brand}</span>
  </a>

  {/* Mono anchors + language switch + rectangular CTA */}
  <nav class="flex items-center gap-1">
    {
      !minimal &&
        links.map((link) => (
          <a
            href={link.href}
            class="hidden h-9 items-center px-3 font-mono text-xs lowercase text-white/55 transition hover:text-white lg:inline-flex"
          >
            {link.label}
          </a>
        ))
    }
    <LanguagePicker locale={locale} altPath={resolvedAltPath} />
    <a
      href={contactHref}
      class="ml-1.5 inline-flex h-9 items-center bg-primary px-4 font-mono text-xs font-semibold uppercase tracking-[0.08em] text-night transition hover:brightness-110"
    >
      {i.nav.cta}
    </a>
  </nav>
</header>
