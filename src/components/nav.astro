---
// Full-width top bar (brutal block): brand segment left, nav segments right,
// every segment divided by a 3px rule; the single CTA is a cobalt segment.
// Anchors (desktop), locale switch, and the CTA → #kontakt stay unchanged.
import LanguagePicker from "@/components/language-picker.astro";
import { getCompanyHome } from "@/data/company-home";
import { getLocalePath, type Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
  /** Path of this page in the other locale (defaults to the localized home). */
  altPath?: string;
  /** Legal/sub pages: no section anchors, CTA points at the home contact form. */
  minimal?: boolean;
  /** Adds the #opinie anchor only while the reviews section is live. */
  showReviews?: boolean;
}

const { locale, altPath, minimal = false, showReviews = false } = Astro.props;
const i = getCompanyHome(locale);
const homePath = getLocalePath(locale);
const altLocale: Locale = locale === "pl" ? "en" : "pl";
const resolvedAltPath = altPath ?? getLocalePath(altLocale);
const contactHref = minimal ? `${homePath}#kontakt` : "#kontakt";

const links = showReviews
  ? [...i.nav.links.slice(0, 3), i.nav.reviewsLink, ...i.nav.links.slice(3)]
  : [...i.nav.links];
---

<header class="fixed inset-x-0 top-0 z-50 border-b-[3px] border-ink bg-offwhite" aria-label="Primary">
  <div class="flex items-stretch justify-between">
    {/* Brand segment */}
    <a href={homePath} class="flex items-center gap-2.5 border-r-[3px] border-ink px-4 py-3 md:px-6">
      <img src="/logo.png" alt="" width="24" height="24" class="h-6 w-6" />
      <span class="hidden font-display text-[15px] uppercase tracking-tight text-ink sm:inline">{i.nav.brand}</span>
    </a>

    {/* Nav segments: anchors + language switch + CTA */}
    <nav class="flex items-stretch">
      {
        !minimal &&
          links.map((link) => (
            <a
              href={link.href}
              class="hidden items-center border-l-[3px] border-ink px-5 text-[13px] font-bold uppercase tracking-wide text-ink transition-colors hover:bg-ink hover:text-white lg:flex"
            >
              {link.label}
            </a>
          ))
      }
      <LanguagePicker locale={locale} altPath={resolvedAltPath} />
      <a
        href={contactHref}
        class="flex items-center border-l-[3px] border-ink bg-cobalt px-3 text-[13px] font-bold uppercase tracking-wide text-white transition-colors hover:bg-ink md:px-6"
      >
        {i.nav.cta}
      </a>
    </nav>
  </div>
</header>
