---
// In-house products: the "why us" proof. Diagonal band, exactly two
// asymmetric cards (58/42), real screenshots, live links.
import Icon from "@/components/icon.astro";
import { getCompanyHome } from "@/data/company-home";
import type { Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = getCompanyHome(locale);
const [odbiera, callwise] = i.products.items;
---

<section id="produkty" class="diag-band scroll-mt-10 bg-band">
  <div class="mx-auto max-w-6xl px-6">
    <div class="animate-on-scroll">
      <p class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-primary-deep">
        [ {i.products.eyebrow} ]
      </p>
      <h2 class="mt-4 text-3xl font-bold tracking-tight text-ink md:text-4xl">{i.products.title}</h2>
      <p class="mt-3 max-w-[60ch] text-base leading-relaxed text-muted md:text-lg">{i.products.subtitle}</p>
    </div>

    <div class="animate-on-scroll mt-10 grid gap-5 lg:grid-cols-[0.58fr_0.42fr]">
      {
        [odbiera, callwise].map((product) => (
          <article class="flex flex-col overflow-hidden rounded-2xl border border-band-strong/50 bg-white shadow-[0_24px_60px_-32px_rgba(1,9,51,0.45)]">
            <div class="overflow-hidden border-b border-band-strong/30">
              <img
                src={product.shot}
                alt={product.shotAlt}
                width="1280"
                height="720"
                class="product-shot-drift aspect-video w-full object-cover"
                loading="lazy"
              />
            </div>
            <div class="flex flex-1 flex-col p-6 md:p-7">
              <div class="flex flex-wrap items-center justify-between gap-3">
                <h3 class="text-xl font-bold tracking-tight text-ink">{product.name}</h3>
                <p class="flex items-center gap-2 font-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-muted">
                  <span class="status-dot" />
                  {i.products.liveLabel}
                </p>
              </div>
              <p class="mt-2 text-[15px] leading-relaxed text-muted">{product.description}</p>
              <a
                href={product.href}
                target="_blank"
                rel="noopener"
                class="mt-auto inline-flex items-center gap-1.5 pt-5 text-sm font-semibold text-primary-deep hover:text-primary"
              >
                {product.linkLabel}
                <Icon name="external-link" class="h-3.5 w-3.5" />
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
