---
// In-house products: the "why us" proof. An asymmetric duo (58/42) with a
// wide horizontal block below, real screenshots in 3px frames, live links.
import Icon from "@/components/icon.astro";
import { getCompanyHome } from "@/data/company-home";
import type { Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = getCompanyHome(locale);
const [odbiera, callwise, courseai] = i.products.items;

const linkClass =
  "mt-auto inline-flex items-center gap-1.5 pt-5 text-sm font-bold text-ink underline decoration-cobalt decoration-[3px] underline-offset-4 transition-colors after:absolute after:inset-0 hover:text-cobalt";
const liveClass = "flex items-center gap-2 text-[10px] font-bold uppercase tracking-[0.14em] text-ink";
---

<section id="produkty" class="scroll-mt-16 border-b-[3px] border-ink bg-offwhite py-20 md:py-24">
  <div class="mx-auto max-w-6xl px-6">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-cobalt">{i.products.eyebrow}</p>
      <h2 class="mt-4 font-display text-3xl uppercase tracking-tight text-ink md:text-4xl">{i.products.title}</h2>
      <p class="mt-4 max-w-[60ch] text-base leading-relaxed text-ink md:text-lg">{i.products.subtitle}</p>
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-[0.58fr_0.42fr]">
      {
        [odbiera, callwise].map((product) => (
          <article class="relative flex flex-col border-[3px] border-ink bg-white">
            <div class="border-b-[3px] border-ink">
              <img
                src={product.shot}
                alt={product.shotAlt}
                width="1280"
                height="720"
                class="aspect-video w-full object-cover"
                loading="lazy"
              />
            </div>
            <div class="flex flex-1 flex-col p-6 md:p-7">
              <div class="flex flex-wrap items-center justify-between gap-3">
                <h3 class="font-display text-lg uppercase tracking-tight text-ink">{product.name}</h3>
                <p class={liveClass}>
                  <span class="status-dot" />
                  {i.products.liveLabel}
                </p>
              </div>
              <p class="mt-2 text-[15px] leading-relaxed text-ink">{product.description}</p>
              {/* Stretched link: the whole block (screenshot included) is the click target. */}
              <a href={product.href} target="_blank" rel="noopener" class={linkClass}>
                {product.linkLabel}
                <Icon name="external-link" class="h-3.5 w-3.5" />
              </a>
            </div>
          </article>
        ))
      }
    </div>

    {/* Third product breaks the duo's rhythm: one wide horizontal block. */}
    <article class="relative mt-6 flex flex-col border-[3px] border-ink bg-white md:flex-row">
      <div class="border-b-[3px] border-ink md:w-[42%] md:border-b-0 md:border-r-[3px]">
        <img
          src={courseai.shot}
          alt={courseai.shotAlt}
          width="1280"
          height="720"
          class="aspect-video h-full w-full object-cover"
          loading="lazy"
        />
      </div>
      <div class="flex flex-1 flex-col p-6 md:p-7">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h3 class="font-display text-lg uppercase tracking-tight text-ink">{courseai.name}</h3>
          <p class={liveClass}>
            <span class="status-dot" />
            {i.products.liveLabel}
          </p>
        </div>
        <p class="mt-2 max-w-[60ch] text-[15px] leading-relaxed text-ink">{courseai.description}</p>
        <a href={courseai.href} target="_blank" rel="noopener" class={linkClass}>
          {courseai.linkLabel}
          <Icon name="external-link" class="h-3.5 w-3.5" />
        </a>
      </div>
    </article>
  </div>
</section>
