---
// Selected projects: one-line outcomes as a two-column list of ink-framed
// cards. Deliberately detached from the timeline — no years, no employers —
// so the axis stays loose and the work speaks for itself.
import { getPeopleRafal } from "@/data/people-rafal";
import type { Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const p = getPeopleRafal(locale).projects;
---

<section id="projekty" class="scroll-mt-16 border-b-[3px] border-ink bg-offwhite py-20 md:py-24">
  <div class="mx-auto max-w-6xl px-6">
    <p class="text-xs font-bold uppercase tracking-[0.18em] text-cobalt">{p.eyebrow}</p>
    <h2 class="mt-4 font-display text-3xl uppercase tracking-tight text-ink md:text-4xl">{p.title}</h2>

    <ul class="mt-12 grid gap-5 md:grid-cols-2">
      {
        p.items.map((item) => (
          <li class="flex gap-4 border-[3px] border-ink bg-white p-5 md:p-6">
            <span aria-hidden="true" class="mt-1.5 block h-3 w-3 shrink-0 bg-cobalt" />
            <p class="text-[15px] leading-relaxed text-ink md:text-base">{item}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
