---
// Person hero (brutal block): one full-viewport stage. Name, title, bio and
// both CTAs on the left; the portrait hangs free on the right as a framed,
// slightly tilted print with a hard ink shadow — the whole photo stays
// visible (square, never cropped). Closed by the ink fact strip.
import Icon from "@/components/icon.astro";
import { getPeopleRafal } from "@/data/people-rafal";
import type { Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const h = getPeopleRafal(locale).hero;
---

{/* pt-[51px] = exact height of the fixed top bar (24px logo + 2x12px padding + 3px border) */}
<section class="flex min-h-[100svh] flex-col border-b-[3px] border-ink bg-offwhite pt-[51px]">
  <div
    class="mx-auto flex w-full max-w-6xl flex-1 flex-col items-center justify-center gap-12 px-6 py-14 lg:flex-row lg:items-center lg:justify-between lg:gap-16 lg:px-10 lg:py-16"
  >
    <div class="flex w-full flex-col items-start gap-7 lg:max-w-[36rem] lg:gap-8">
      <div class="flex flex-col gap-4">
        <h1
          class="font-display text-5xl uppercase leading-[0.98] tracking-tight text-ink [text-wrap:balance] md:text-6xl lg:text-[clamp(4rem,6vw,5.5rem)]"
        >
          {h.name}
        </h1>
        <p class="text-base font-bold uppercase tracking-wide text-ink md:text-lg">{h.title}</p>
      </div>
      <div class="flex max-w-[52ch] flex-col gap-3">
        {h.bio.map((line) => <p class="text-lg font-medium leading-normal text-ink">{line}</p>)}
      </div>
      <div class="flex flex-wrap items-center gap-4">
        <a href={h.primaryHref} target="_blank" rel="noopener" class="btn-primary">
          {h.primaryCta}
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
        <a href={h.secondaryHref} class="btn-ghost">
          {h.secondaryCta}
          <Icon name="mail" class="h-4 w-4" />
        </a>
      </div>
    </div>

    {/* Framed print hanging free in the layout: full photo, 3px ink frame, hard shadow, slight tilt. */}
    <figure class="w-52 shrink-0 -rotate-2 sm:w-64 lg:w-[21rem] xl:w-[23rem]">
      <img
        src={h.photo}
        srcset={`${h.photoSmall} 560w, ${h.photo} 1000w`}
        sizes="(min-width: 1280px) 23rem, (min-width: 1024px) 21rem, (min-width: 640px) 16rem, 13rem"
        alt={h.photoAlt}
        width="1000"
        height="1000"
        class="block h-auto w-full border-[3px] border-ink bg-white shadow-[12px_12px_0_0_#131320]"
        loading="eager"
        decoding="async"
      />
    </figure>
  </div>

  <ul class="flex flex-col border-t-[3px] border-ink bg-ink py-3 sm:flex-row sm:py-0">
    {
      h.facts.map((fact) => (
        <li class="px-6 py-1 text-xs font-bold uppercase tracking-[0.1em] text-offwhite sm:py-4 lg:px-10">{fact}</li>
      ))
    }
  </ul>
</section>
