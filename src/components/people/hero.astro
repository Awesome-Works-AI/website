---
// Person hero (brutal block): two-column grid split by a 3px rule — name,
// title, bio and both CTAs on the left; the portrait as a full-height block
// on the right. Closed by the ink fact strip (true facts only).
import Icon from "@/components/icon.astro";
import { getPeopleRafal } from "@/data/people-rafal";
import type { Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const h = getPeopleRafal(locale).hero;
---

{/* pt-[51px] = exact height of the fixed top bar (24px logo + 2x12px padding + 3px border) */}
<section class="border-b-[3px] border-ink bg-offwhite pt-[51px]">
  <div class="grid lg:grid-cols-[3fr_2fr]">
    <div class="flex flex-col items-start justify-center gap-7 px-6 py-16 md:py-20 lg:gap-8 lg:px-10 lg:py-24">
      <p class="flex items-center gap-3 text-xs font-bold uppercase tracking-[0.18em] text-cobalt">
        <span class="font-display text-base" aria-hidden="true">01</span>
        {h.eyebrow}
      </p>
      <div class="flex flex-col gap-4">
        <h1
          class="font-display text-5xl uppercase leading-[0.98] tracking-tight text-ink [text-wrap:balance] md:text-6xl lg:text-[clamp(4rem,6vw,5.5rem)]"
        >
          {h.name}
        </h1>
        <p class="text-base font-bold uppercase tracking-wide text-ink md:text-lg">{h.title}</p>
      </div>
      <div class="flex max-w-[52ch] flex-col gap-3">
        {h.bio.map((line) => <p class="text-lg font-medium leading-normal text-ink">{line}</p>)}
      </div>
      <div class="flex flex-wrap items-center gap-4">
        <a href={h.primaryHref} target="_blank" rel="noopener" class="btn-primary">
          {h.primaryCta}
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
        <a href={h.secondaryHref} class="btn-ghost">
          {h.secondaryCta}
          <Icon name="mail" class="h-4 w-4" />
        </a>
      </div>
    </div>

    {/* Portrait block: full-bleed in its column, clipped square, 3px rule to the left on desktop. */}
    <div class="relative min-h-[22rem] border-t-[3px] border-ink bg-white lg:min-h-0 lg:border-l-[3px] lg:border-t-0">
      <img
        src={h.photo}
        alt={h.photoAlt}
        width="1246"
        height="1662"
        class="absolute inset-0 h-full w-full object-cover object-top"
        loading="eager"
        decoding="async"
      />
    </div>
  </div>

  <ul class="flex flex-col border-t-[3px] border-ink bg-ink py-3 sm:flex-row sm:py-0">
    {
      h.facts.map((fact) => (
        <li class="px-6 py-1 text-xs font-bold uppercase tracking-[0.1em] text-offwhite sm:py-4 lg:px-10">{fact}</li>
      ))
    }
  </ul>
</section>
