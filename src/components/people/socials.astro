---
// Socials stage: one full-viewport section with the three profile links as
// big square blocks centered on the page — icons only, no labels. Brutal
// translation of the former round-button stage: 3px ink borders, no radius,
// hover inverts to cobalt. Icons come from the shared monocolor set.
import Icon from "@/components/icon.astro";
import { getPeopleRafal } from "@/data/people-rafal";
import type { Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = getPeopleRafal(locale).socials;
---

<section
  id="sociale"
  class="flex min-h-[100svh] scroll-mt-16 flex-col items-center justify-center border-b-[3px] border-ink bg-offwhite px-6 py-20"
>
  <ul class="flex flex-wrap items-center justify-center gap-6 sm:gap-10 md:gap-14">
    {
      s.items.map((item) => (
        <li>
          <a
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={item.name}
            title={item.name}
            class="grid h-28 w-28 place-items-center border-[3px] border-ink bg-white text-ink transition-colors hover:bg-cobalt hover:text-white sm:h-36 sm:w-36 md:h-44 md:w-44"
          >
            <Icon name={item.icon} class="h-14 w-14 sm:h-[4.5rem] sm:w-[4.5rem] md:h-24 md:w-24" />
          </a>
        </li>
      ))
    }
  </ul>
</section>
