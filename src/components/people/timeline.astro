---
// Career timeline: one vertical 3px ink axis with square cobalt markers,
// oldest stage first so the axis runs into "today" right above the contact
// block. Every entry = years, company, role, one sentence of outcome; the
// facts come from the CV only (see data/people-rafal.ts).
import { getPeopleRafal } from "@/data/people-rafal";
import type { Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getPeopleRafal(locale).timeline;

const years = (from: string, to: string) => {
  if (!to) return `${from} → ${t.presentLabel}`;
  if (to === from) return from;
  return `${from}–${to}`;
};
---

<section id="droga" class="scroll-mt-16 border-b-[3px] border-ink bg-white py-20 md:py-24">
  <div class="mx-auto max-w-6xl px-6">
    <div>
      <p class="flex items-center gap-3 text-xs font-bold uppercase tracking-[0.18em] text-cobalt">
        <span class="font-display text-base" aria-hidden="true">03</span>
        {t.eyebrow}
      </p>
      <h2 class="mt-4 font-display text-3xl uppercase tracking-tight text-ink md:text-4xl">{t.title}</h2>
      <p class="mt-4 max-w-[60ch] text-base leading-relaxed text-ink md:text-lg">{t.subtitle}</p>
    </div>

    <ol class="relative mt-14 ml-2 border-l-[3px] border-ink md:ml-0">
      {
        t.items.map((item, idx) => (
          <li
            class:list={[
              "relative pl-8 md:grid md:grid-cols-[11rem_1fr] md:gap-10 md:pl-12",
              idx < t.items.length - 1 ? "pb-12 md:pb-14" : "pb-2",
            ]}
          >
            {/* Square marker sitting on the axis; the last (current) one is cobalt. */}
            <span
              aria-hidden="true"
              class:list={[
                "absolute -left-[12px] top-1 h-[21px] w-[21px] border-[3px] border-ink",
                idx === t.items.length - 1 ? "bg-cobalt" : "bg-white",
              ]}
            />
            <p class="font-display text-xl leading-none text-ink md:text-2xl">{years(item.from, item.to)}</p>
            <div class="mt-3 md:mt-0">
              <h3 class="font-display text-lg uppercase tracking-tight text-ink">{item.company}</h3>
              <p class="mt-1 text-sm font-bold uppercase tracking-wide text-cobalt">{item.role}</p>
              <p class="mt-3 max-w-[60ch] text-[15px] leading-relaxed text-ink">{item.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
