---
// Cobalt CTA block: one button and a single line under it. Two variants share
// the look — `booking` (Calendly, sits right under the hero) and `showcase`
// (link to the company homepage, sits right above the contact form so the
// visitor only leaves this page at the very end).
import { getPeopleRafal } from "@/data/people-rafal";
import type { Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
  variant?: "booking" | "showcase";
}

const { locale, variant = "booking" } = Astro.props;
const p = getPeopleRafal(locale);
const b = variant === "showcase" ? p.showcase : p.booking;
const id = variant === "showcase" ? "co-robimy" : "umow";
const external = variant === "booking";
---

<section id={id} class="scroll-mt-16 border-b-[3px] border-ink bg-cobalt px-6 py-24 text-center md:py-32">
  <a
    href={b.href}
    target={external ? "_blank" : undefined}
    rel={external ? "noopener" : undefined}
    class="inline-block border-[3px] border-ink bg-white px-10 py-5 font-display text-xl uppercase tracking-tight text-ink shadow-[6px_6px_0_0_#131320] transition-transform hover:-translate-y-0.5 active:translate-x-[3px] active:translate-y-[3px] active:shadow-none md:px-14 md:py-6 md:text-2xl"
  >
    {b.cta}
  </a>
  <p class="mx-auto mt-6 max-w-[40ch] text-sm font-medium text-white md:text-base">{b.note}</p>
</section>
