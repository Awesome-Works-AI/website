---
// Footer: continuation of the dark contact band. Company data, section
// anchors, product links, privacy + socials (icons only, no card grid).
import Icon from "@/components/icon.astro";
import { getCompanyHome, privacyPath } from "@/data/company-home";
import { getLocalePath, type Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = getCompanyHome(locale);
const f = i.footer;
const homePath = getLocalePath(locale);
const privacyHref = privacyPath(locale);
---

<footer class="bg-dark text-white/70">
  <div class="mx-auto max-w-6xl px-6 pb-8 pt-4">
    <div class="grid gap-10 border-t border-white/10 pt-10 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div>
        <a href={homePath} class="inline-flex items-center gap-2">
          <img src="/logo.png" alt="" width="28" height="28" class="h-7 w-7" loading="lazy" />
          <span class="text-base font-bold tracking-tight text-white">AwesomeWorks</span>
        </a>
        <p class="mt-4 max-w-[36ch] text-sm leading-relaxed">{f.brandLine}</p>
        <p class="mt-4 text-xs leading-relaxed text-white/50">{f.legalLine}</p>
      </div>

      <nav aria-label={f.companyTitle}>
        <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-white/50">{f.companyTitle}</p>
        <ul class="mt-4 space-y-2.5">
          {
            f.companyLinks.map((link) => (
              <li>
                <a href={`${homePath}${link.href}`} class="text-sm transition hover:text-white">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label={f.productsTitle}>
        <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-white/50">{f.productsTitle}</p>
        <ul class="mt-4 space-y-2.5">
          {
            f.productLinks.map((link) => (
              <li>
                <a href={link.href} target="_blank" rel="noopener" class="text-sm transition hover:text-white">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-white/50">{f.legalTitle}</p>
        <ul class="mt-4 space-y-2.5">
          <li>
            <a href={privacyHref} class="text-sm transition hover:text-white">{f.privacyLabel}</a>
          </li>
        </ul>
        <ul class="mt-5 flex items-center gap-3">
          {
            f.socials.map((social) => (
              <li>
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener"
                  aria-label={social.name}
                  class="grid h-9 w-9 place-items-center rounded-full border border-white/15 text-white/70 transition hover:border-white/40 hover:text-white"
                >
                  <Icon name={social.icon} class="h-4 w-4" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <p class="mt-10 border-t border-white/10 pt-6 text-xs text-white/50">{f.copyright}</p>
  </div>
</footer>
