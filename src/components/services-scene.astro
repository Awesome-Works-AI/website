---
// Services: an interactive terminal on the family diagonal band. Service
// names run as command lines in a dark terminal window; picking one swaps
// the robot (crossfade) and prints that service's description as output.
// Mobile: the command list becomes a horizontally scrollable row.
import Icon from "@/components/icon.astro";
import { getCompanyHome } from "@/data/company-home";
import type { Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = getCompanyHome(locale);
const termTitle = locale === "en" ? "awesomeworks:~/services" : "awesomeworks:~/uslugi";
---

<section id="uslugi" class="scroll-mt-24 overflow-x-clip bg-white py-20 md:py-24">
  <div class="mx-auto max-w-6xl px-6">
    <div class="animate-on-scroll">
      <h2 class="text-3xl font-bold tracking-tight text-ink md:text-4xl">{i.services.title}</h2>
      <p class="mt-3 max-w-[60ch] text-base leading-relaxed text-muted md:text-lg">{i.services.subtitle}</p>
    </div>
  </div>

  <div data-scene-root class="scene mt-10 md:mt-12">
    <div class="mx-auto max-w-6xl px-6">
      <div class="term animate-on-scroll">
        <div class="term-bar">
          <span class="term-dot"></span>
          <span class="term-dot"></span>
          <span class="term-dot"></span>
          <span class="ml-2 font-mono text-[11px] font-semibold tracking-[0.08em] text-white/50">{termTitle}</span>
        </div>

        <div class="term-body gap-8 p-6 md:p-8 lg:grid lg:grid-cols-[0.42fr_0.58fr] lg:gap-12">
          {/* Command list */}
          <div class="flex gap-1 overflow-x-auto pb-3 lg:flex-col lg:overflow-visible lg:pb-0" role="list">
            {
              i.services.items.map((item, idx) => (
                <button
                  type="button"
                  data-scene-tab
                  data-idx={idx}
                  aria-current={idx === 0 ? "true" : "false"}
                  class="term-line flex flex-none items-baseline gap-2.5 rounded-md px-3 py-2.5 text-left font-mono"
                >
                  <span class="term-prompt text-[13px]" aria-hidden="true">
                    &gt;
                  </span>
                  <span class="text-[13px] font-semibold tracking-tight md:text-sm">{item.name}</span>
                  <span class="term-cursor" aria-hidden="true" />
                </button>
              ))
            }
          </div>

          {/* Output: robot crossfade + per-service description */}
          <div class="mt-6 grid gap-6 lg:mt-0 lg:grid-cols-[auto_1fr] lg:items-center lg:gap-10">
            <div class="scene-stage grid place-items-center">
              {
                i.services.items.map((item, idx) => (
                  <img
                    data-scene-img
                    src={item.image}
                    alt={item.imageAlt || item.name}
                    class="scene-img"
                    style={idx === 0 ? "opacity:1" : "opacity:0"}
                    loading="lazy"
                    decoding="async"
                  />
                ))
              }
            </div>
            <div>
              {
                i.services.items.map((item, idx) => {
                  const proofClass =
                    "mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-white underline decoration-white/40 underline-offset-4 hover:decoration-white";
                  return (
                    <div data-scene-panel data-idx={idx} hidden={idx !== 0}>
                      <p class="max-w-[46ch] text-[15px] leading-relaxed text-white/90 md:text-base">{item.text}</p>
                      {item.id === "chat" ? (
                        <button type="button" data-open-chat class:list={[proofClass, "text-left"]}>
                          {item.proofLabel}
                          <Icon name="message-circle" class="h-3.5 w-3.5 flex-none" />
                        </button>
                      ) : item.proofHref ? (
                        <a href={item.proofHref} target="_blank" rel="noopener" class={proofClass}>
                          {item.proofLabel}
                          <Icon name="external-link" class="h-3.5 w-3.5 flex-none" />
                        </a>
                      ) : (
                        <p class="mt-5 text-sm font-medium text-white/80">{item.proofLabel}</p>
                      )}
                    </div>
                  );
                })
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* The stage stays a family diagonal band; the terminal sits on it. */
  .scene {
    clip-path: polygon(0 0, 100% var(--slant), 100% 100%, 0 calc(100% - var(--slant)));
    padding-top: calc(var(--slant) + 2.5rem);
    padding-bottom: calc(var(--slant) + 2.5rem);
    background-image: linear-gradient(120deg, var(--color-primary) 0%, var(--color-primary-deep) 85%);
  }

  .term {
    overflow: hidden;
    border-radius: 0.75rem;
    border: 1px solid rgb(255 255 255 / 0.16);
    background: color-mix(in srgb, var(--color-dark) 90%, #ffffff);
    box-shadow: 0 40px 80px -40px rgb(0 0 0 / 0.55);
  }

  .term-bar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
    background: rgb(255 255 255 / 0.04);
  }

  .term-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.22);
  }

  /* Faint blueprint grid behind the session. */
  .term-body {
    background-image:
      linear-gradient(to right, rgb(255 255 255 / 0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.035) 1px, transparent 1px);
    background-size: 34px 34px;
  }

  .term-line {
    color: rgb(255 255 255 / 0.6);
    transition: color 0.2s ease, background 0.2s ease;
  }

  .term-line:hover {
    color: #ffffff;
  }

  .term-prompt {
    color: color-mix(in srgb, var(--color-primary-bright) 75%, #ffffff);
  }

  .term-line[aria-current="true"] {
    background: rgb(255 255 255 / 0.08);
    color: #ffffff;
  }

  /* Block cursor blinks only on the active command line. */
  .term-cursor {
    display: none;
    width: 0.5em;
    height: 1em;
    align-self: center;
    background: color-mix(in srgb, var(--color-primary-bright) 75%, #ffffff);
  }

  .term-line[aria-current="true"] .term-cursor {
    display: inline-block;
    animation: term-blink 1.1s steps(1) infinite;
  }

  @keyframes term-blink {
    50% {
      opacity: 0;
    }
  }

  .scene-stage {
    min-height: 13rem;
  }

  .scene-img {
    grid-area: 1 / 1;
    max-height: min(40vh, 17rem);
    width: auto;
    transition: opacity 0.45s ease;
    filter: drop-shadow(0 22px 32px rgb(0 0 0 / 0.4));
  }

  @media (prefers-reduced-motion: reduce) {
    .term-line,
    .scene-img {
      transition: none;
    }

    .term-line[aria-current="true"] .term-cursor {
      animation: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-scene-root]").forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-scene-tab]")];
    const imgs = [...root.querySelectorAll<HTMLElement>("[data-scene-img]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-scene-panel]")];

    const activate = (idx: number) => {
      tabs.forEach((tab, j) => tab.setAttribute("aria-current", j === idx ? "true" : "false"));
      imgs.forEach((img, j) => {
        img.style.opacity = j === idx ? "1" : "0";
      });
      panels.forEach((panel, j) => {
        panel.hidden = j !== idx;
      });
    };

    tabs.forEach((tab, idx) => {
      tab.addEventListener("click", () => activate(idx));
      tab.addEventListener("keydown", (event) => {
        const delta =
          event.key === "ArrowDown" || event.key === "ArrowRight"
            ? 1
            : event.key === "ArrowUp" || event.key === "ArrowLeft"
              ? -1
              : 0;
        if (!delta) return;
        event.preventDefault();
        const next = (idx + delta + tabs.length) % tabs.length;
        tabs[next].focus();
        activate(next);
      });
    });
  });
</script>
