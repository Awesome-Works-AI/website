---
// Services: a hard service index (brutal block rows). Picking a row swaps
// the robot (crossfade) and its description; the active row inverts to
// cobalt, hover inverts to ink. Mobile: the index becomes a horizontally
// scrollable row of segments.
import Icon from "@/components/icon.astro";
import { getCompanyHome } from "@/data/company-home";
import type { Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = getCompanyHome(locale);
---

<section id="uslugi" class="scroll-mt-16 border-b-[3px] border-ink bg-white py-20 md:py-24">
  <div class="mx-auto max-w-6xl px-6">
    <div>
      <h2 class="font-display text-3xl uppercase tracking-tight text-ink md:text-4xl">{i.services.title}</h2>
      <p class="mt-4 max-w-[60ch] text-base leading-relaxed text-ink md:text-lg">{i.services.subtitle}</p>
    </div>

    <div data-scene-root class="mt-10 md:mt-12 lg:grid lg:grid-cols-[0.42fr_0.58fr] lg:gap-12">
      {/* Service index: numbered hard rows */}
      <div class="flex overflow-x-auto border-[3px] border-ink lg:flex-col lg:overflow-visible" role="list">
        {
          i.services.items.map((item, idx) => (
            <button
              type="button"
              data-scene-tab
              data-idx={idx}
              aria-current={idx === 0 ? "true" : "false"}
              class="scene-row flex flex-none items-center gap-3 border-r-[3px] border-ink px-4 py-4 text-left last:border-r-0 lg:w-full lg:border-r-0 lg:border-b-[3px] lg:px-5 lg:last:border-b-0"
            >
              <span class="font-display text-xs" aria-hidden="true">
                {String(idx + 1).padStart(2, "0")}
              </span>
              <span class="text-[13px] font-bold uppercase tracking-wide md:text-sm">{item.name}</span>
            </button>
          ))
        }
      </div>

      {/* Output: robot crossfade + per-service description */}
      <div class="mt-8 grid gap-6 md:grid-cols-[auto_1fr] md:items-center md:gap-10 lg:mt-0">
        <div class="scene-stage grid place-items-center border-[3px] border-ink bg-offwhite p-6">
          {
            i.services.items.map((item, idx) => (
              <img
                data-scene-img
                src={item.image}
                alt={item.imageAlt}
                class="scene-img"
                style={idx === 0 ? "opacity:1" : "opacity:0"}
                loading="lazy"
                decoding="async"
              />
            ))
          }
        </div>
        <div>
          {
            i.services.items.map((item, idx) => {
              const proofClass =
                "mt-5 inline-flex items-center gap-1.5 text-sm font-bold text-ink underline decoration-cobalt decoration-[3px] underline-offset-4 transition-colors hover:text-cobalt";
              return (
                <div data-scene-panel data-idx={idx} hidden={idx !== 0}>
                  <p class="max-w-[46ch] text-[15px] leading-relaxed text-ink md:text-base">{item.text}</p>
                  {item.id === "chat" ? (
                    <button type="button" data-open-chat class:list={[proofClass, "text-left"]}>
                      {item.proofLabel}
                      <Icon name="message-circle" class="h-3.5 w-3.5 flex-none" />
                    </button>
                  ) : item.proofHref ? (
                    <a href={item.proofHref} target="_blank" rel="noopener" class={proofClass}>
                      {item.proofLabel}
                      <Icon name="external-link" class="h-3.5 w-3.5 flex-none" />
                    </a>
                  ) : (
                    <p class="mt-5 text-sm font-bold text-ink">{item.proofLabel}</p>
                  )}
                </div>
              );
            })
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Row states: idle white, hover inverts to ink, active inverts to cobalt. */
  .scene-row {
    background: #ffffff;
    color: var(--color-ink);
    transition: background 0.15s ease, color 0.15s ease;
  }

  .scene-row:hover {
    background: var(--color-ink);
    color: #ffffff;
  }

  .scene-row[aria-current="true"] {
    background: var(--color-cobalt);
    color: #ffffff;
  }

  .scene-stage {
    min-height: 13rem;
  }

  .scene-img {
    grid-area: 1 / 1;
    max-height: min(40vh, 17rem);
    width: auto;
    transition: opacity 0.45s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .scene-row,
    .scene-img {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-scene-root]").forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-scene-tab]")];
    const imgs = [...root.querySelectorAll<HTMLElement>("[data-scene-img]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-scene-panel]")];

    const activate = (idx: number) => {
      tabs.forEach((tab, j) => tab.setAttribute("aria-current", j === idx ? "true" : "false"));
      imgs.forEach((img, j) => {
        img.style.opacity = j === idx ? "1" : "0";
      });
      panels.forEach((panel, j) => {
        panel.hidden = j !== idx;
      });
    };

    tabs.forEach((tab, idx) => {
      tab.addEventListener("click", () => activate(idx));
      tab.addEventListener("keydown", (event) => {
        const delta =
          event.key === "ArrowDown" || event.key === "ArrowRight"
            ? 1
            : event.key === "ArrowUp" || event.key === "ArrowLeft"
              ? -1
              : 0;
        if (!delta) return;
        event.preventDefault();
        const next = (idx + delta + tabs.length) % tabs.length;
        tabs[next].focus();
        activate(next);
      });
    });
  });
</script>
